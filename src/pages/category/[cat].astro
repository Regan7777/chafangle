---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import RightNav from '../../components/RightNav.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const categoryMap = [
    { cat: 'tongbao', title: '宿管通报', desc: '宿舍管理处官方通报、巡楼纪要与重要公示。' },
    { cat: 'zhuabao', title: '当场抓包', desc: '每周例行巡查，数据不说谎。实抓连通率、丢包率与网络抖动。' },
    { cat: 'mofan', title: '模范寝室', desc: '长期稳定、表现优异的服务记录。免检通报，推荐关注。' },
    { cat: 'meishou', title: '没收作案工具', desc: '异常断流、夸大宣传与避坑档案。直接拉闸，严防踩坑。' },
    { cat: 'jiaocheng', title: '入住教程', desc: '新手租客必读教程与客户端配置全攻略。包含 Clash、Shadowrocket、Sing-box 等配置使用教程。' },
  ];

  return categoryMap.map((item) => ({
    params: { cat: item.cat },
    props: { catInfo: item },
  }));
}

interface Props {
  catInfo: {
    cat: string;
    title: string;
    desc: string;
  };
}

const { catInfo } = Astro.props;
const { cat } = Astro.params;

const allPosts = await getCollection('posts');
const filteredPosts = allPosts
  .filter((post) => post.data.category === cat)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Category map
---

<BaseLayout
  title={`${catInfo.title} - VPN查房巡楼卷宗`}
  description={catInfo.desc}
>
  <div class="container category-page">
    <div class="page-layout-grid">
      <div class="main-column">
        <div class="page-header industrial-box">
          <span class="industrial-badge industrial-badge-red font-mono">卷宗分类</span>
          <h1 class="page-title">{catInfo.title}</h1>
          <p class="page-intro">{catInfo.desc}</p>

          <div class="cat-filter-tabs font-mono">
            <a href="/posts" class="tab-link">全部</a>
            <a href="/category/mofan" class={`tab-link ${cat === 'mofan' ? 'active' : ''}`}>模范寝室</a>
            <a href="/category/tongbao" class={`tab-link ${cat === 'tongbao' ? 'active' : ''}`}>宿管通报</a>
            <a href="/category/zhuabao" class={`tab-link ${cat === 'zhuabao' ? 'active' : ''}`}>当场抓包</a>
            <a href="/category/meishou" class={`tab-link ${cat === 'meishou' ? 'active' : ''}`}>没收作案工具</a>
            <a href="/category/jiaocheng" class={`tab-link ${cat === 'jiaocheng' ? 'active' : ''}`}>入住教程</a>
          </div>
        </div>

        {filteredPosts.length > 0 ? (
          <div class="posts-grid">
            {filteredPosts.map((post) => (
              <ArticleCard
                title={post.data.title}
                description={post.data.description}
                slug={post.slug}
                date={post.data.pubDate.toISOString().split('T')[0]}
                category={post.data.category}
                verdict={post.data.verdict}
                badge={post.data.badge}
                isPinned={post.data.isPinned}
              />
            ))}
          </div>
        ) : (
          <div class="empty-box industrial-box font-mono">
            宿管巡查提示：该卷宗分类暂未归档新纪要。
          </div>
        )}
      </div>

      <!-- Right Sidebar Navigation -->
      <aside class="right-sidebar-column">
        <RightNav activeId="01" title="⚡ 热门机场速览" />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .category-page {
    max-width: 1200px;
  }

  .page-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 992px) {
    .page-layout-grid {
      grid-template-columns: 1fr 320px;
      gap: 3rem;
    }
    .right-sidebar-column {
      margin-left: 1.5rem;
      position: sticky;
      top: 5rem;
    }
  }

  .page-header {
    margin-bottom: 2rem;
    background: #ffffff;
  }

  .page-title {
    font-size: 2.2rem;
    margin-top: 0.5rem;
    margin-bottom: 0.6rem;
  }

  .page-intro {
    font-size: 1rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .cat-filter-tabs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    border-top: 1.5px dashed var(--border-muted);
    padding-top: 1rem;
  }

  .tab-link {
    background: var(--bg-primary);
    border: 1.5px solid var(--border-thick);
    padding: 0.35rem 0.8rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--text-main);
  }

  .tab-link.active,
  .tab-link:hover {
    background: var(--accent-red);
    color: #ffffff;
  }

  .empty-box {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--text-muted);
  }
</style>
