  '14-shenxing-jiasu-iepl-premium-review',
  '15-dalaoyun-bgp-high-value-review',
  '17-liulianyun-native-ip-unlock-review',
  '19-yunjiexian-pure-iepl-dedicated-review',
  '18-huanqiuti-global-business-review',
  '16-shandianshu-fast-latency-review',
];

const allPosts = await getCollection('posts');
const filteredPosts = allPosts
  .filter((post) => post.data.category === cat)
  .sort((a, b) => {
    const aCoreIdx = coreSlugs.indexOf(a.slug);
    const bCoreIdx = coreSlugs.indexOf(b.slug);
    if (aCoreIdx !== -1 && bCoreIdx !== -1) return aCoreIdx - bCoreIdx;
    if (aCoreIdx !== -1) return -1;
    if (bCoreIdx !== -1) return 1;
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  });

// Category map
---

<BaseLayout
  title={`${catInfo.title} - VPN查房巡楼卷宗`}
  description={catInfo.desc}
>
  <div class="container category-page">
    <div class="page-layout-grid">
      <div class="main-column">
        <div class="page-header industrial-box">
          <span class="industrial-badge industrial-badge-red font-mono">卷宗分类</span>
          <h1 class="page-title">{catInfo.title}</h1>
          <p class="page-intro">{catInfo.desc}</p>

          <div class="cat-filter-tabs font-mono">
            <a href="/posts" class="tab-link">全部</a>
            <a href="/category/zhuabao" class={`tab-link ${cat === 'zhuabao' ? 'active' : ''}`}>机场评测</a>
            <a href="/category/mofan" class={`tab-link ${cat === 'mofan' ? 'active' : ''}`}>机场推荐</a>
            <a href="/category/meishou" class={`tab-link ${cat === 'meishou' ? 'active' : ''}`}>跑路机场</a>
            <a href="/category/tongbao" class={`tab-link ${cat === 'tongbao' ? 'active' : ''}`}>宿管通报</a>
            <a href="/category/jiaocheng" class={`tab-link ${cat === 'jiaocheng' ? 'active' : ''}`}>入住教程</a>
          </div>
        </div>

        {cat === 'mofan' ? (
          <!-- 机场推荐专用：6大核心主推机场专属卡片展示 -->
          <div class="mofan-recommend-showcase">
            <div class="recommend-showcase-intro industrial-box-dark font-mono">
              <div class="showcase-status-bar">
                <span class="status-dot blinking"></span>
                <span class="showcase-title">🏆 宿管核准 · 2026年度 6 大五星推荐机场</span>
              </div>
              <p class="showcase-desc">
                以下 6 家机场经宿管大爷 7×24 小时例行突击巡查与晚高峰全周 MTR 压测核准。按用户体验与综合实力严格排序（1神行 2大佬云 3榴莲 4云界线 5环球梯 6闪电鼠）。全线支持专属新客 7 折优惠码，各具特色、拒绝虚标！
              </p>
            </div>

            <div class="recommend-cards-container">
              {featuredRecommendAirports.map((airport) => (
                <RecommendAirportCard airport={airport} />
              ))}
            </div>

            {filteredPosts.length > 0 && (
              <section class="historical-posts-section">
                <div class="historical-section-header">
                  <h3 class="section-title font-mono">
                    <span class="title-icon">📖</span> 6 大核心主推机场实测长文卷宗
                  </h3>
                  <span class="text-muted font-mono" style="font-size: 0.85rem;">严格按主推优先级排序</span>
                </div>
                <div class="posts-grid">
                  {filteredPosts.map((post) => (
                    <ArticleCard
                      title={post.data.title}
                      description={post.data.description}
                      slug={post.slug}
                      date={post.data.pubDate.toISOString().split('T')[0]}
                      category={post.data.category}
                      verdict={post.data.verdict}
                      badge={post.data.badge}
                      isPinned={post.data.isPinned}
                    />
                  ))}
                </div>
              </section>
            )}
          </div>
        ) : filteredPosts.length > 0 ? (
          <div class="posts-grid">
            {filteredPosts.map((post) => (
              <ArticleCard
                title={post.data.title}
                description={post.data.description}
                slug={post.slug}
                date={post.data.pubDate.toISOString().split('T')[0]}
                category={post.data.category}
                verdict={post.data.verdict}
                badge={post.data.badge}
                isPinned={post.data.isPinned}
              />
            ))}
          </div>
        ) : (
          <div class="empty-box industrial-box font-mono">
            宿管巡查提示：该卷宗分类暂未归档新纪要。
          </div>
        )}
      </div>

      <!-- Right Sidebar Navigation -->
      <aside class="right-sidebar-column">
        <RightNav activeId="01" title="⚡ 热门机场速览" />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .category-page {
    max-width: 1200px;
  }

  .page-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 992px) {
    .page-layout-grid {
      grid-template-columns: 1fr 320px;
      gap: 3rem;
    }
    .right-sidebar-column {
      margin-left: 1.5rem;
      position: sticky;
      top: 5rem;
    }
  }

  .page-header {
    margin-bottom: 2rem;
    background: #ffffff;
  }

  .page-title {
    font-size: 2.2rem;
    margin-top: 0.5rem;
    margin-bottom: 0.6rem;
  }

  .page-intro {
    font-size: 1rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .cat-filter-tabs {
