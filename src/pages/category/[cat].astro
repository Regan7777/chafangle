---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import RightNav from '../../components/RightNav.astro';
import { getCollection } from 'astro:content';

import RecommendAirportCard, { type RecommendAirportData } from '../../components/RecommendAirportCard.astro';

export async function getStaticPaths() {
  const categoryMap = [
    { cat: 'zhuabao', title: '机场评测', desc: '每周例行巡查，数据不说谎。实抓连通率、丢包率与网络抖动。' },
    { cat: 'mofan', title: '机场推荐', desc: '宿管7×24小时连续高压巡查认证。精选2026年度6大五星推荐主力机场，拒绝断流与虚标，全线支持新客专属7折。' },
    { cat: 'meishou', title: '跑路机场', desc: '异常断流、夸大宣传与跑路避坑档案。直接拉闸，严防踩坑。' },
    { cat: 'tongbao', title: '宿管通报', desc: '宿舍管理处官方通报、巡楼纪要与重要公示。' },
    { cat: 'jiaocheng', title: '入住教程', desc: '新手租客必读教程与客户端配置全攻略。包含 Clash、Shadowrocket、Sing-box 等配置使用教程。' },
  ];

  return categoryMap.map((item) => ({
    params: { cat: item.cat },
    props: { catInfo: item },
  }));
}

interface Props {
  catInfo: {
    cat: string;
    title: string;
    desc: string;
  };
}

const { catInfo } = Astro.props;
const { cat } = Astro.params;

