---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InspectionBadge from '../../components/InspectionBadge.astro';
import TestMetaGrid from '../../components/TestMetaGrid.astro';
import StampWatermark from '../../components/StampWatermark.astro';
import SponsorBatteryModal from '../../components/SponsorBatteryModal.astro';
import RightNav from '../../components/RightNav.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await post.render();
const { data } = post;

const formattedDate = data.pubDate.toISOString().split('T')[0];

const navIdMap: Record<string, string> = {
  '14-shenxing-jiasu-iepl-premium-review': '01',
  '15-dalaoyun-bgp-high-value-review': '02',
  '17-liulianyun-native-ip-unlock-review': '03',
  '18-huanqiuti-global-business-review': '04',
  '19-yunjiexian-pure-iepl-dedicated-review': '05',
  '16-shandianshu-fast-latency-review': '06',
  '05-custom-bgp-iepl-hybrid-airport-review': '07',
};

const currentActiveId = navIdMap[post.slug] || '01';

const corePromotedSlugs = [
  '14-shenxing-jiasu-iepl-premium-review',
  '15-dalaoyun-bgp-high-value-review',
  '17-liulianyun-native-ip-unlock-review',
  '19-yunjiexian-pure-iepl-dedicated-review',
  '18-huanqiuti-global-business-review',
  '16-shandianshu-fast-latency-review',
];

const isCorePromoted = corePromotedSlugs.includes(post.slug);
// 严格控制：机场评测与非主推站绝不显示五星推荐，仅 6 个主推站点保留五星推荐
const effectiveVerdict = isCorePromoted
  ? 'five-star'
  : (data.verdict === 'five-star' ? undefined : data.verdict);
---

<BaseLayout
  title={`${data.title} - VPN查房实测卷宗`}
  description={data.description}
  keywords={data.keywords}
  type="article"
  publishDate={data.pubDate}
  updatedDate={data.updatedDate}
  author={data.author}
>
  <div class="container article-page-container">
    <div class="article-layout-grid">
      <!-- Main Article Column -->
      <article class="article-main-column">
        <!-- Breadcrumb Nav -->
        <nav class="breadcrumb-nav font-mono" aria-label="面包屑导航">
          <a href="/">首页</a> <span>/</span> 
          <a href="/posts">巡楼纪要</a> <span>/</span> 
          <span class="active-crumb">{data.title}</span>
        </nav>

        <!-- Post Header Block -->
        <header class="post-header industrial-box">
          <div class="post-meta-top">
            {data.isPinned && <span class="badge-pinned">📌 宿管置顶通报</span>}
            <span class="badge-cat font-mono">卷宗分类: {data.category}</span>
            <time class="post-time font-mono" datetime={formattedDate}>归档日期: {formattedDate}</time>
          </div>

          <h1 class="article-heading">{data.title}</h1>
          <p class="article-desc-lead">{data.description}</p>

          <!-- Prominent Official Affiliate Link & Coupon Box (if officialUrl provided) -->
          {data.officialUrl && (
            <div class="official-access-banner">
              <div class="access-info font-mono">
                {data.pricePlan && <div class="access-item"><strong>套餐价格：</strong><span>{data.pricePlan}</span></div>}
                {data.promoCode && <div class="access-item"><strong>专属优惠码：</strong><code class="promo-code">{data.promoCode}</code></div>}
              </div>
              <a href={data.officialUrl} target="_blank" rel="noopener noreferrer" class="btn-official-direct">
                🚀 官网直达通道 / 领取专属优惠 ➔
              </a>
            </div>
          )}

          <div class="header-stamp-corner">
            <StampWatermark text="VPN查房了·突击取证专用章" subText="宿管巡楼签发" size="sm" />
          </div>
        </header>

        <!-- Test Meta Grid (if review metrics present) -->
        {data.metrics && data.metrics.length > 0 && (
          <TestMetaGrid
            testDate={formattedDate}
            location={data.testLocation}
            isp={data.testIsp}
            peakHours={data.testPeakHours}
            metrics={data.metrics}
          />
        )}

        <!-- Room Inspection Conclusion Component -->
        {effectiveVerdict && (
          <InspectionBadge
            verdict={effectiveVerdict}
            customNote={data.verdictNote}
          />
        )}

        <!-- Main Post Content -->
        <div class="post-prose-content industrial-box">
          <Content />

          <!-- Bottom Direct Link Button -->
          {data.officialUrl && (
            <div class="bottom-direct-link-box">
              <h3>⚡ 专属官方入口与特惠通道</h3>
              <p>点击下方按钮直接跳转至官方注册页面，结账时填入优惠码 <code>{data.promoCode || '专属折扣'}</code> 即可享限时特惠：</p>
              <a href={data.officialUrl} target="_blank" rel="noopener noreferrer" class="btn-official-direct-large">
                👉 前往 {data.title.replace(/【.*?】/, '')} 官方网站 ➔
              </a>
            </div>
          )}
        </div>

        <!-- Interactive Sponsor Battery & Comments Notice Component -->
        <SponsorBatteryModal />
      </article>

      <!-- Right Sidebar Navigation -->
      <aside class="article-sidebar-column">
        <RightNav activeId={currentActiveId} title="⚡ 巡楼全景导航" />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .article-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 992px) {
    .article-layout-grid {
      grid-template-columns: 1fr 320px;
      gap: 3rem;
    }
    .article-sidebar-column {
      margin-left: 1.5rem;
    }
  }

  .article-sidebar-column {
    position: sticky;
    top: 5rem;
  }

  .article-page {
    max-width: 1200px;
    margin: 0 auto;
  }

  .breadcrumb-nav {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
    display: flex;
    gap: 0.4rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .breadcrumb-nav a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb-nav a:hover {
    color: var(--accent-red);
  }

  .active-crumb {
    color: var(--text-main);
    font-weight: 700;
  }

  .post-header {
    margin-bottom: 2rem;
    position: relative;
    background: #ffffff;
  }

  .post-meta-top {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    margin-bottom: 0.8rem;
    flex-wrap: wrap;
  }

  .badge-pinned {
    background: var(--accent-red);
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.15rem 0.5rem;
  }

  .badge-cat {
    background: #e2dfd5;
    border: 1px solid var(--border-thick);
    padding: 0.15rem 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .post-time {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .article-heading {
    font-size: 2.2rem;
    margin-top: 0.4rem;
    margin-bottom: 0.8rem;
    line-height: 1.3;
  }

  .article-desc-lead {
    font-size: 1.05rem;
    color: #444444;
    border-left: 3px solid var(--accent-red);
    padding-left: 0.8rem;
    margin-bottom: 1rem;
  }

  /* Official Direct Link Banner Styling */
  .official-access-banner {
    background: #18181b;
    color: #ffffff;
    border: 2px solid var(--border-thick);
    box-shadow: 4px 4px 0px var(--accent-red);
    padding: 1.2rem 1.4rem;
    margin-top: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .access-info {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.95rem;
  }

  .access-item strong {
    color: #ffffff;
  }

  .promo-code {
    background: var(--accent-red);
    color: #ffffff;
    font-weight: 900;
    padding: 0.15rem 0.5rem;
    border: 1px fill #ffffff;
    font-size: 0.95rem;
  }

  .btn-official-direct {
    background: var(--accent-red);
    color: #ffffff;
    font-weight: 900;
    font-size: 1.05rem;
    padding: 0.75rem 1.4rem;
    text-decoration: none;
    border: 2px solid #ffffff;
    box-shadow: 3px 3px 0px #000000;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .btn-official-direct:hover {
    background: #b81d1d;
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px #000000;
    color: #ffffff;
  }

  .bottom-direct-link-box {
    background: #f8f7f2;
    border: 2.5px dashed var(--accent-red);
    padding: 1.5rem;
    margin-top: 2rem;
    text-align: center;
  }

  .bottom-direct-link-box h3 {
    margin-top: 0;
    font-size: 1.3rem;
  }

  .btn-official-direct-large {
    display: inline-block;
    background: var(--accent-red);
    color: #ffffff;
    font-weight: 900;
    font-size: 1.15rem;
    padding: 0.85rem 1.8rem;
    text-decoration: none;
    border: 2.5px solid var(--border-thick);
    box-shadow: 4px 4px 0px var(--border-thick);
    margin-top: 1rem;
    transition: all 0.15s ease;
  }

  .btn-official-direct-large:hover {
    background: #b81d1d;
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0px var(--border-thick);
    color: #ffffff;
  }

  .header-stamp-corner {
    position: absolute;
    right: 1rem;
    top: 1rem;
  }

  .post-prose-content {
    background: #ffffff;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  @media (max-width: 768px) {
    .header-stamp-corner {
      display: none;
    }
    .article-heading {
      font-size: 1.6rem;
    }
    .official-access-banner {
      flex-direction: column;
      align-items: flex-start;
    }
    .btn-official-direct {
      width: 100%;
      text-align: center;
    }
  }
</style>
