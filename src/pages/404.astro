---
import BaseLayout from '../layouts/BaseLayout.astro';
import StampWatermark from '../components/StampWatermark.astro';
import RightNav from '../components/RightNav.astro';
---

<BaseLayout
  title="404 - 敲了半天门没人应｜VPN查房"
  description="敲了半天门没人应——该页面疑似已失联。"
>
  <div class="container error-page-wrapper">
    <div class="page-layout-grid">
      <div class="main-column">
        <div class="error-card industrial-box-dark">
          <div class="error-code font-mono">404 ERROR</div>
          <h1 class="error-headline">敲了半天门没人应——该页面疑似已失联。</h1>
          <p class="error-sub">
            宿管拿着手电筒在门口等了五分钟，房间里黑灯瞎火，该链接可能已被删除、更名或提桶跑路。
          </p>

          <div class="stamp-404-wrapper">
            <StampWatermark text="失联空房·VPN查房记录" subText="页面 404 已拉闸" size="lg" />
          </div>

          <div class="error-actions">
            <a href="/" class="btn-home">
              🚪 返回VPN查房首页
            </a>
            <a href="/posts" class="btn-all">
              📑 翻阅其它卷宗
            </a>
          </div>
        </div>
      </div>

      <!-- Right Sidebar Navigation -->
      <aside class="right-sidebar-column">
        <RightNav activeId="01" title="⚡ 热门机场速览" />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .error-page-wrapper {
    max-width: 1200px;
    margin: 2rem auto;
  }

  .page-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 992px) {
    .page-layout-grid {
      grid-template-columns: 1fr 320px;
      gap: 3rem;
    }
    .right-sidebar-column {
      margin-left: 1.5rem;
      position: sticky;
      top: 5rem;
    }
  }

  .error-card {
    border-width: 3px;
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .error-code {
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--accent-red);
    letter-spacing: 2px;
    margin-bottom: 0.5rem;
  }

  .error-headline {
    font-size: 1.8rem;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .error-sub {
    font-size: 1.05rem;
    color: #cccccc;
    max-width: 550px;
    margin-bottom: 1.5rem;
  }

  .stamp-404-wrapper {
    margin: 1rem 0 2rem 0;
  }

  .error-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-home {
    background: var(--accent-red);
    color: #ffffff;
    font-weight: 900;
    padding: 0.7rem 1.4rem;
    text-decoration: none;
    border: 2px solid #ffffff;
    box-shadow: 4px 4px 0px #000000;
  }

  .btn-home:hover {
    background: #b81d1d;
  }

  .btn-all {
    background: var(--bg-surface);
    color: var(--text-main);
    font-weight: 800;
    padding: 0.7rem 1.4rem;
    text-decoration: none;
    border: 2px solid #ffffff;
    box-shadow: 4px 4px 0px #000000;
  }

  .btn-all:hover {
    background: #e2dfd5;
  }
</style>
