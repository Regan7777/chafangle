---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import StampWatermark from '../components/StampWatermark.astro';
import RightNav from '../components/RightNav.astro';
import { getCollection } from 'astro:content';

// Fetch all posts
const allPosts = await getCollection('posts');

// 6 Core Featured Airport Reviews in strict priority order:
// 1. 神行加速 -> 2. 大佬云 -> 3. 榴莲云 -> 4. 云界线 -> 5. 环球梯 -> 6. 闪电鼠
const coreSlugs = [
  '14-shenxing-jiasu-iepl-premium-review',
  '15-dalaoyun-bgp-high-value-review',
  '17-liulianyun-native-ip-unlock-review',
  '19-yunjiexian-pure-iepl-dedicated-review',
  '18-huanqiuti-global-business-review',
  '16-shandianshu-fast-latency-review',
];

const corePosts = coreSlugs
  .map(slug => allPosts.find(p => p.slug === slug))
  .filter((p): p is (typeof allPosts)[0] => Boolean(p));

// Other posts sorted by pubDate
const otherPosts = allPosts
  .filter(p => !coreSlugs.includes(p.slug))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Assemble final homepage list: 6 Core Featured Airports first, followed by others
const latestPosts = [
  ...corePosts,
  ...otherPosts,
].slice(0, 10);
---

<BaseLayout
  title="2026机场推荐｜每周网络服务巡检与避坑指南"
  description="面向 VPN、机场代理与网络服务用户的中文评测博客。以周为单位巡查，不让断流蒙混过关。提供2026最稳定的 VPN / 机场推荐、性价比服务对比、IEPL专线与BGP中转周巡查报告。"
  showPatrolCat={false}
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-card hero-card-layout">
        <!-- Left Text & Actions Column (100% Crisp Native Vector HTML) -->
        <div class="hero-text-content">
          <div class="hero-status-bar">
            <span class="status-indicator-light"></span>
            <span class="status-text font-mono">宿管已上线，今周例行巡检中。</span>
          </div>

          <div class="title-group">
            <h1 class="hero-title">2026机场推荐</h1>
            <p class="hero-subtitle">白天全绿不算数，一周 7×24 小时扛得住才算数。</p>
          </div>

          <div class="hero-intro">
            <p>记录网络服务在每周例行巡检中的公开测试与体验观察，拒绝虚标与口头承诺，周周为单位巡查。</p>
            <p>MTR 丢包率、TCP 延迟与开播速度说话，面向机场代理用户，从小白到大神都能找到需要的工具箱。</p>
          </div>

          <div class="hero-actions">
            <a href="/category/mofan" class="btn-primary">
              <span class="btn-icon">🔑</span> 领取查房钥匙串
            </a>
            <a href="/handbook" class="btn-secondary">
              <span class="btn-icon">📖</span> 查阅防坑手册
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Comic Strip Section (4-Panel Dorm Patrol Interactive Comics) -->
  <section class="comic-strip-section" aria-label="宿管日常巡检四格漫画">
    <div class="container">
      <div class="comic-cards-grid">
        <a href="/category/zhuabao" class="comic-card" title="日常巡逻 - 机场评测" aria-label="日常巡逻：跳转至机场评测">
          <img src="/images/comic-panel-1-hd.png" alt="日常巡逻" width="540" height="655" loading="eager" />
        </a>
        <a href="/category/meishou" class="comic-card" title="发现异常 (抓包) - 跑路避坑" aria-label="发现异常：跳转至跑路避坑档案">
          <img src="/images/comic-panel-2-hd.png" alt="发现异常 (抓包)" width="540" height="655" loading="eager" />
        </a>
        <a href="/category/mofan" class="comic-card" title="盖章通过 - 机场推荐" aria-label="盖章通过：跳转至五星推荐机场">
          <img src="/images/comic-panel-3-hd.png" alt="盖章通过" width="540" height="655" loading="eager" />
        </a>
        <a href="/category/jiaocheng" class="comic-card" title="提供钥匙 - 入住教程" aria-label="提供钥匙：跳转至入住教程">
          <img src="/images/comic-panel-4-hd.png" alt="提供钥匙" width="540" height="655" loading="eager" />
        </a>
      </div>
    </div>
  </section>

  <!-- Main Content Body -->
  <div class="container index-body-grid">
    <div class="page-layout-grid">
      <!-- Left Main Column -->
      <div class="main-column">
        <!-- Section: Four Category Cards -->
        <section class="category-cards-section">
          <h2 class="section-title">
            <span class="title-icon">📂</span> 巡楼分类卷宗
          </h2>
          <div class="category-grid">
            <CategoryCard
              title="机场评测"
              description="每周例行巡查，数据不说谎。实测丢包与延迟。"
              href="/category/zhuabao"
              badge="突击抓包"
              badgeType="red"
            />
            <CategoryCard
              title="机场推荐"
              description="长期稳定、表现优异的服务记录。五星推荐。"
              href="/category/mofan"
              badge="五星推荐"
              badgeType="dark"
            />
            <CategoryCard
              title="跑路机场"
              description="异常断流、夸大宣传与跑路避坑档案。"
              href="/category/meishou"
              badge="拉闸避坑"
              badgeType="red"
            />
            <CategoryCard
              title="入住教程"
              description="零基础小白教程，Clash与小火箭全攻略。"
              href="/category/jiaocheng"
              badge="新手指南"
              badgeType="dark"
            />
          </div>
        </section>

        <!-- Section: Latest Patrol Posts -->
        <section id="patrol-posts" class="posts-section">
          <div class="section-header">
            <h2 class="section-title">
              <span class="title-icon">📝</span> 最新巡楼纪要
            </h2>
            <a href="/posts" class="view-all-link">查看全部卷宗 ({allPosts.length}) ➔</a>
          </div>

          <div class="posts-list">
            {latestPosts.map((post) => (
              <ArticleCard
                title={post.data.title}
                description={post.data.description}
                slug={post.slug}
                date={post.data.pubDate.toISOString().split('T')[0]}
                category={post.data.category}
                verdict={post.data.verdict}
                badge={post.data.badge}
                isPinned={post.data.isPinned}
              />
            ))}
          </div>
        </section>

        <!-- Section: SEO / GEO Keyword Guide Banner -->
        <section class="seo-guide-banner industrial-box">
          <h3>🔍 宿管避坑指南与关键词检索</h3>
          <p>
            查找 <strong>2026最稳定的机场</strong>、<strong>性价比机场推荐</strong>、<strong>机场代理选购</strong> 或是解决周巡断流卡顿？宿管已为你分类归档：
          </p>
          <div class="keyword-pill-group">
            <a href="/posts" class="kw-pill">机场代理实测</a>
            <a href="/category/mofan" class="kw-pill">2026最稳定的机场</a>
            <a href="/handbook" class="kw-pill">性价比机场避坑指南</a>
            <a href="/category/zhuabao" class="kw-pill">每周巡查丢包抓包</a>
            <a href="/about" class="kw-pill">查房博客评测标准</a>
          </div>
        </section>
      </div>

      <!-- Right Sidebar Column: Structured Right Navigation -->
      <aside class="right-sidebar-column">
        <RightNav activeId="01" title="⚡ 热门机场速览" />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .hero-section {
    margin-bottom: 0.8rem;
    position: relative;
    overflow: visible;
  }

  .hero-card {
    background: transparent url('/images/hero-card-clean-backdrop.png') no-repeat center top;
    background-size: 100% auto;
    border: none;
    box-shadow: none;
    position: relative;
    overflow: visible;
    border-radius: 0;
    aspect-ratio: 2048 / 844;
    min-height: 420px;
    padding: 2rem 2.8rem 4rem 2.8rem;
    display: flex;
    align-items: flex-start;
    box-sizing: border-box;
  }

  .hero-card-layout {
    display: flex;
    align-items: flex-start;
    width: 100%;
    height: 100%;
  }

  .hero-text-content {
    flex: 1;
    max-width: 470px;
    z-index: 2;
  }

  .hero-status-bar {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0;
    margin-bottom: 0.75rem;
    font-size: 0.82rem;
  }

  .status-indicator-light {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 6px #22c55e;
    display: inline-block;
  }

  .status-text {
    color: #9ca3af;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .title-group {
    margin-bottom: 0.75rem;
  }

  .hero-title {
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    color: #ffffff;
    letter-spacing: -0.5px;
    margin-bottom: 0.3rem;
    font-weight: 900;
    line-height: 1.15;
  }

  .hero-subtitle {
    font-size: clamp(0.95rem, 1.4vw, 1.15rem);
    color: #c01818;
    font-weight: 800;
    line-height: 1.35;
  }

  .hero-intro {
    font-size: clamp(0.82rem, 1.05vw, 0.92rem);
    color: #ffffff;
    line-height: 1.65;
    margin-bottom: 1.25rem;
    max-width: 460px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.7);
  }

  .hero-intro p {
    color: #ffffff;
    margin-bottom: 0.35rem;
  }

  .hero-actions {
    display: flex;
    gap: 0.85rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .btn-primary, .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 1rem;
    font-weight: 800;
    font-size: 0.88rem;
    text-decoration: none;
    border-radius: 2px;
    transition: all 0.15s ease;
    box-sizing: border-box;
  }

  .btn-icon {
    font-size: 0.92rem;
  }

  /* Left Red Button: strictly matches reference design */
  .btn-primary {
    background: #c01818;
    color: #ffffff;
    border: 1.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
  }

  .btn-primary:hover {
    background: #a81515;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    color: #ffffff;
  }

  /* Right Dark Button: strictly matches reference design */
  .btn-secondary {
    background: #1f242e;
    color: #ffffff;
    border: 1.5px solid rgba(255, 255, 255, 0.65);
    box-shadow: 2px 2px 0px rgba(0, 0, 0, 0.6);
  }

  .btn-secondary:hover {
    background: #2a313d;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px rgba(0, 0, 0, 0.8);
    color: #ffffff;
  }

  /* 4-Panel Dorm Patrol Interactive Comic Cards Section */
  .comic-strip-section {
    margin-top: 1.2rem;
    margin-bottom: 2.8rem;
    position: relative;
    z-index: 3;
  }

  .comic-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    width: 100%;
  }

  .comic-card {
    display: block;
    text-decoration: none;
    cursor: pointer;
    position: relative;
    transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.2s ease;
    border-radius: 4px;
    overflow: visible;
  }

  .comic-card:hover {
    transform: translateY(-6px);
    filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.14));
  }

  .comic-card img {
    display: block;
    width: 100%;
    height: auto;
    border: none;
    border-radius: 2px;
  }

  @media (max-width: 1120px) {
    .hero-card {
      padding: 2.2rem 2.4rem 6rem 2.4rem;
    }

    .hero-text-content {
      max-width: 54%;
    }

    .hero-title {
      font-size: 2.7rem;
    }
  }

  @media (max-width: 860px) {
    .hero-card {
      background-size: cover;
      background-position: 70% top;
      padding: 2.2rem 1.5rem 4rem 1.5rem;
      min-height: 460px;
    }

    .hero-text-content {
      max-width: 70%;
    }

    .hero-title {
      font-size: 2.2rem;
    }
  }

  @media (max-width: 768px) {
    .comic-cards-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }
  }

  @media (max-width: 480px) {
    .hero-card {
      padding: 1.8rem 1.2rem 3.5rem 1.2rem;
      min-height: 420px;
      background-position: 75% top;
    }

    .hero-text-content {
      max-width: 88%;
    }

    .hero-title {
      font-size: 1.85rem;
    }

    .hero-subtitle {
      font-size: 1.05rem;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .btn-primary, .btn-secondary {
      width: 100%;
      justify-content: center;
    }

    .comic-cards-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.6rem;
    }
  }

  .index-body-grid {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.5rem;
    margin-bottom: 1.25rem;
    border-bottom: 2px solid var(--border-thick);
    padding-bottom: 0.4rem;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  /* Two-column Layout: Main on Left, RightNav on Right */
  .page-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 992px) {
    .page-layout-grid {
      grid-template-columns: 1fr 320px;
      gap: 3rem;
    }
    .right-sidebar-column {
      margin-left: 1.5rem;
      position: sticky;
      top: 5rem;
    }
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.25rem;
    border-bottom: 2px solid var(--border-thick);
    padding-bottom: 0.4rem;
  }

  .section-header .section-title {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .view-all-link {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--accent-red);
    text-decoration: none;
  }

  .view-all-link:hover {
    text-decoration: underline;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .seo-guide-banner {
    background: #eef2ff;
    border-color: #1d4ed8;
    box-shadow: 4px 4px 0px #1d4ed8;
  }

  .seo-guide-banner h3 {
    margin-top: 0;
    color: #1e3a8a;
  }

  .seo-guide-banner p {
    color: #334155;
    margin-bottom: 1rem;
  }

  .keyword-pill-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .kw-pill {
    background: #ffffff;
    border: 1.5px solid #1d4ed8;
    color: #1d4ed8;
    padding: 0.3rem 0.8rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .kw-pill:hover {
    background: #1d4ed8;
    color: #ffffff;
  }
</style>
