---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import StampWatermark from '../components/StampWatermark.astro';
import RightNav from '../components/RightNav.astro';
import { getCollection } from 'astro:content';

// Fetch all posts
const allPosts = await getCollection('posts');

// 6 Core Featured Airport Reviews in strict priority order:
// 1. 神行加速 -> 2. 大佬云 -> 3. 榴莲云 -> 4. 云界线 -> 5. 环球梯 -> 6. 闪电鼠
const coreSlugs = [
  '14-shenxing-jiasu-iepl-premium-review',
  '15-dalaoyun-bgp-high-value-review',
  '17-liulianyun-native-ip-unlock-review',
  '19-yunjiexian-pure-iepl-dedicated-review',
  '18-huanqiuti-global-business-review',
  '16-shandianshu-fast-latency-review',
];

const corePosts = coreSlugs
  .map(slug => allPosts.find(p => p.slug === slug))
  .filter((p): p is (typeof allPosts)[0] => Boolean(p));

// Other posts sorted by pubDate
const otherPosts = allPosts
  .filter(p => !coreSlugs.includes(p.slug))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Assemble final homepage list: 6 Core Featured Airports first, followed by others
const latestPosts = [
  ...corePosts,
  ...otherPosts,
].slice(0, 10);
---

<BaseLayout
  title="2026机场推荐｜每周网络服务巡检与避坑指南"
  description="面向 VPN、机场代理与网络服务用户的中文评测博客。以周为单位巡查，不让断流蒙混过关。提供2026最稳定的 VPN / 机场推荐、性价比服务对比、IEPL专线与BGP中转周巡查报告。"
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-card hero-card-layout">
        <!-- Left Text & Actions Column (100% Crisp Native Vector HTML) -->
        <div class="hero-text-content">
          <div class="hero-status-bar">
            <span class="status-indicator-light blinking"></span>
            <span class="status-text font-mono">宿管已上线，本周例行巡楼中。</span>
          </div>

          <div class="title-group">
            <h1 class="hero-title">2026机场推荐</h1>
            <p class="hero-subtitle">白天全绿不算数，一周 7×24 小时扛得住才算数。</p>
          </div>

          <p class="hero-intro">
            记录网络服务在每周例行巡检中的公开测试与体验观察，提供去水份的实测数据、网络应急避坑指南与自救工具箱。
          </p>

          <div class="hero-actions">
            <a href="/category/mofan" class="btn-primary">
              🔑 领取查房钥匙串
            </a>
            <a href="/handbook" class="btn-secondary">
              📖 查阅防坑手册
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Comic Strip Section (4-Panel Dorm Patrol Comics with Interactive Links) -->
  <section class="comic-strip-section" aria-label="宿管日常巡检四格漫画">
    <div class="container">
      <div class="comic-strip-wrapper">
        <!-- Desktop High-Res Single Strip with 4 Interactive Hotspots -->
        <div class="comic-strip-desktop-container">
          <img 
            src="/images/comic-strip-hd.png" 
            alt="宿管日常巡检四格漫画：日常巡逻、发现异常 (抓包)、盖章通过、提供钥匙" 
            class="comic-strip-desktop-img"
            width="2260"
            height="635"
            loading="eager"
          />
          <div class="comic-strip-hotspots">
            <a href="/category/zhuabao" class="comic-hotspot" title="格1【日常巡逻】➔ 查看「机场评测」每周例行巡检" aria-label="日常巡逻：跳转至机场评测">
              <span class="hotspot-pill">进入「机场评测」 ➔</span>
            </a>
            <a href="/category/meishou" class="comic-hotspot" title="格2【发现异常 (抓包)】➔ 查看「跑路机场」避坑档案" aria-label="发现异常：跳转至跑路避坑档案">
              <span class="hotspot-pill">查看「跑路避坑」 ➔</span>
            </a>
            <a href="/category/mofan" class="comic-hotspot" title="格3【盖章通过】➔ 查看「机场推荐」五星推荐名单" aria-label="盖章通过：跳转至五星推荐机场">
              <span class="hotspot-pill">查看「机场推荐」 ➔</span>
            </a>
            <a href="/category/jiaocheng" class="comic-hotspot" title="格4【提供钥匙】➔ 查看「入住教程」新手全攻略" aria-label="提供钥匙：跳转至入住教程">
              <span class="hotspot-pill">查看「入住教程」 ➔</span>
            </a>
          </div>
        </div>

        <!-- Mobile Responsive 2x2 Grid with Direct Links -->
        <div class="comic-strip-mobile-grid">
          <a href="/category/zhuabao" class="comic-panel-link" title="日常巡逻 - 机场评测" aria-label="日常巡逻：跳转至机场评测">
            <div class="comic-panel-box">
              <img src="/images/comic-panel-1-hd.png" alt="日常巡逻" width="560" height="635" loading="lazy" />
              <span class="mobile-panel-tag">评测 ➔</span>
            </div>
          </a>
          <a href="/category/meishou" class="comic-panel-link" title="发现异常 (抓包) - 跑路避坑" aria-label="发现异常：跳转至跑路避坑档案">
            <div class="comic-panel-box">
              <img src="/images/comic-panel-2-hd.png" alt="发现异常 (抓包)" width="560" height="635" loading="lazy" />
              <span class="mobile-panel-tag">避坑 ➔</span>
            </div>
          </a>
          <a href="/category/mofan" class="comic-panel-link" title="盖章通过 - 机场推荐" aria-label="盖章通过：跳转至五星推荐机场">
            <div class="comic-panel-box">
              <img src="/images/comic-panel-3-hd.png" alt="盖章通过" width="560" height="635" loading="lazy" />
              <span class="mobile-panel-tag">推荐 ➔</span>
            </div>
          </a>
          <a href="/category/jiaocheng" class="comic-panel-link" title="提供钥匙 - 入住教程" aria-label="提供钥匙：跳转至入住教程">
            <div class="comic-panel-box">
              <img src="/images/comic-panel-4-hd.png" alt="提供钥匙" width="560" height="635" loading="lazy" />
              <span class="mobile-panel-tag">教程 ➔</span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Body -->
  <div class="container index-body-grid">
    <div class="page-layout-grid">
      <!-- Left Main Column -->
      <div class="main-column">
        <!-- Section: Four Category Cards -->
        <section class="category-cards-section">
          <h2 class="section-title">
            <span class="title-icon">📂</span> 巡楼分类卷宗
          </h2>
          <div class="category-grid">
            <CategoryCard
              title="机场评测"
              description="每周例行巡查，数据不说谎。实测丢包与延迟。"
              href="/category/zhuabao"
              badge="突击抓包"
              badgeType="red"
            />
            <CategoryCard
              title="机场推荐"
              description="长期稳定、表现优异的服务记录。五星推荐。"
              href="/category/mofan"
              badge="五星推荐"
              badgeType="dark"
            />
            <CategoryCard
              title="跑路机场"
              description="异常断流、夸大宣传与跑路避坑档案。"
              href="/category/meishou"
              badge="拉闸避坑"
              badgeType="red"
            />
            <CategoryCard
              title="入住教程"
              description="零基础小白教程，Clash与小火箭全攻略。"
              href="/category/jiaocheng"
              badge="新手指南"
              badgeType="dark"
            />
          </div>
        </section>

        <!-- Section: Latest Patrol Posts -->
        <section id="patrol-posts" class="posts-section">
          <div class="section-header">
            <h2 class="section-title">
              <span class="title-icon">📝</span> 最新巡楼纪要
            </h2>
            <a href="/posts" class="view-all-link">查看全部卷宗 ({allPosts.length}) ➔</a>
          </div>

          <div class="posts-list">
            {latestPosts.map((post) => (
              <ArticleCard
                title={post.data.title}
                description={post.data.description}
                slug={post.slug}
                date={post.data.pubDate.toISOString().split('T')[0]}
                category={post.data.category}
                verdict={post.data.verdict}
                badge={post.data.badge}
                isPinned={post.data.isPinned}
              />
            ))}
          </div>
        </section>

        <!-- Section: SEO / GEO Keyword Guide Banner -->
        <section class="seo-guide-banner industrial-box">
          <h3>🔍 宿管避坑指南与关键词检索</h3>
          <p>
            查找 <strong>2026最稳定的机场</strong>、<strong>性价比机场推荐</strong>、<strong>机场代理选购</strong> 或是解决周巡断流卡顿？宿管已为你分类归档：
          </p>
          <div class="keyword-pill-group">
            <a href="/posts" class="kw-pill">机场代理实测</a>
            <a href="/category/mofan" class="kw-pill">2026最稳定的机场</a>
            <a href="/handbook" class="kw-pill">性价比机场避坑指南</a>
            <a href="/category/zhuabao" class="kw-pill">每周巡查丢包抓包</a>
            <a href="/about" class="kw-pill">查房博客评测标准</a>
          </div>
        </section>
      </div>

      <!-- Right Sidebar Column: Structured Right Navigation -->
      <aside class="right-sidebar-column">
        <RightNav activeId="01" title="⚡ 热门机场速览" />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .hero-section {
    margin-bottom: 1.5rem;
  }

  .hero-card {
    background: transparent url('/images/hero-card-clean-backdrop.png') no-repeat right top;
    background-size: cover;
    border: none;
    box-shadow: none;
    position: relative;
    border-radius: 4px;
    min-height: 460px;
    padding: 2.8rem 2.8rem 4rem 2.8rem;
    display: flex;
    align-items: center;
  }

  .hero-card-layout {
    display: flex;
    align-items: center;
    width: 100%;
  }

  .hero-text-content {
    flex: 1;
    max-width: 520px;
    z-index: 2;
  }

  .hero-status-bar {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    border-bottom: 1.5px dashed #44444a;
    padding-bottom: 0.8rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
  }

  .status-indicator-light {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
    display: inline-block;
  }

  .status-indicator-light.blinking {
    animation: blink 1.5s infinite ease-in-out;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .status-text {
    color: #ffffff;
    font-weight: 700;
  }

  .title-group {
    margin-bottom: 1rem;
  }

  .hero-title {
    font-size: 3.1rem;
    color: #ffffff;
    letter-spacing: -1px;
    margin-bottom: 0.45rem;
    font-weight: 900;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.7);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--accent-red);
    font-weight: 800;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }

  .hero-intro {
    font-size: 1.05rem;
    color: #e5e7eb;
    line-height: 1.75;
    margin-bottom: 1.8rem;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
  }

  .hero-actions {
    display: flex;
    gap: 1.1rem;
    flex-wrap: wrap;
  }

  .btn-primary, .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.6rem;
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
    border-radius: 2px;
    transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .btn-primary {
    background: var(--accent-red);
    color: #ffffff;
    border: 2px solid #ffffff;
    box-shadow: 3px 3px 0px #ffffff;
  }

  .btn-primary:hover {
    background: var(--accent-red-hover);
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px #ffffff;
    color: #ffffff;
  }

  .btn-secondary {
    background: #111113;
    color: #ffffff;
    border: 2px solid #ffffff;
    box-shadow: 3px 3px 0px rgba(255, 255, 255, 0.35);
  }

  .btn-secondary:hover {
    background: #ffffff;
    color: var(--text-main);
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px var(--border-thick);
  }

  /* 4-Panel Dorm Patrol Comic Strip Section */
  .comic-strip-section {
    margin-bottom: 2.8rem;
  }

  .comic-strip-wrapper {
    width: 100%;
    border-radius: 4px;
    overflow: hidden;
  }

  .comic-strip-desktop-container {
    position: relative;
    width: 100%;
    border-radius: 4px;
    overflow: hidden;
    filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.08));
  }

  .comic-strip-desktop-img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.22s ease;
  }

  .comic-strip-hotspots {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    z-index: 5;
  }

  .comic-hotspot {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 1.5rem;
    text-decoration: none;
    cursor: pointer;
    position: relative;
    transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .comic-hotspot:hover,
  .comic-hotspot:focus-visible {
    background: rgba(227, 33, 37, 0.045);
    box-shadow: inset 0 0 0 3px var(--accent-red);
  }

  .hotspot-pill {
    opacity: 0;
    transform: translateY(8px);
    transition: all 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
    background: #111113;
    color: #ffffff;
    border: 2px solid var(--accent-red);
    padding: 0.38rem 0.95rem;
    border-radius: 20px;
    font-size: 0.88rem;
    font-weight: 800;
    box-shadow: 2px 2px 0px var(--accent-red);
    pointer-events: none;
    white-space: nowrap;
    letter-spacing: 0.02em;
  }

  .comic-hotspot:hover .hotspot-pill,
  .comic-hotspot:focus-visible .hotspot-pill {
    opacity: 1;
    transform: translateY(0);
  }

  .comic-strip-mobile-grid {
    display: none;
  }

  .comic-panel-link {
    display: block;
    text-decoration: none;
    color: inherit;
    position: relative;
    transition: transform 0.2s ease;
  }

  .comic-panel-link:hover,
  .comic-panel-link:active {
    transform: translateY(-3px);
  }

  .comic-panel-box {
    position: relative;
    border-radius: 2px;
    overflow: hidden;
  }

  .mobile-panel-tag {
    position: absolute;
    right: 8px;
    bottom: 8px;
    background: #111113;
    color: #ffffff;
    font-size: 0.76rem;
    font-weight: 800;
    padding: 0.22rem 0.6rem;
    border-radius: 12px;
    border: 1.5px solid var(--accent-red);
    box-shadow: 1px 1px 0px var(--accent-red);
    letter-spacing: 0.02em;
  }

  @media (max-width: 1120px) {
    .hero-card {
      padding: 2.2rem 2rem;
    }

    .hero-text-content {
      max-width: 58%;
      background: rgba(17, 17, 19, 0.78);
      backdrop-filter: blur(5px);
      padding: 1.4rem 1.6rem;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 4px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
    }

    .hero-title {
      font-size: 2.7rem;
    }
  }

  @media (max-width: 860px) {
    .hero-card {
      background-position: top right;
      padding: 2rem 1.25rem;
      min-height: auto;
    }

    .hero-text-content {
      max-width: 100%;
      background: rgba(17, 17, 19, 0.88);
      backdrop-filter: blur(6px);
      padding: 1.5rem 1.25rem;
      border: 1.5px solid #333338;
      border-radius: 4px;
    }

    .hero-title {
      font-size: 2.3rem;
    }
  }

  @media (max-width: 768px) {
    .comic-strip-desktop-container {
      display: none;
    }

    .comic-strip-mobile-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.85rem;
    }

    .comic-panel-box img {
      width: 100%;
      height: auto;
      display: block;
      border: 2px solid var(--border-thick);
      box-shadow: 2px 2px 0px var(--border-thick);
      background: #f4f2eb;
      border-radius: 2px;
    }
  }

  @media (max-width: 480px) {
    .hero-title {
      font-size: 1.85rem;
    }

    .hero-subtitle {
      font-size: 1.05rem;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .btn-primary, .btn-secondary {
      width: 100%;
      justify-content: center;
    }

    .comic-strip-mobile-grid {
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
    }
  }

  .index-body-grid {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.5rem;
    margin-bottom: 1.25rem;
    border-bottom: 2px solid var(--border-thick);
    padding-bottom: 0.4rem;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  /* Two-column Layout: Main on Left, RightNav on Right */
  .page-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 992px) {
    .page-layout-grid {
      grid-template-columns: 1fr 320px;
      gap: 3rem;
    }
    .right-sidebar-column {
      margin-left: 1.5rem;
      position: sticky;
      top: 5rem;
    }
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.25rem;
    border-bottom: 2px solid var(--border-thick);
    padding-bottom: 0.4rem;
  }

  .section-header .section-title {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .view-all-link {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--accent-red);
    text-decoration: none;
  }

  .view-all-link:hover {
    text-decoration: underline;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .seo-guide-banner {
    background: #eef2ff;
    border-color: #1d4ed8;
    box-shadow: 4px 4px 0px #1d4ed8;
  }

  .seo-guide-banner h3 {
    margin-top: 0;
    color: #1e3a8a;
  }

  .seo-guide-banner p {
    color: #334155;
    margin-bottom: 1rem;
  }

  .keyword-pill-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .kw-pill {
    background: #ffffff;
    border: 1.5px solid #1d4ed8;
    color: #1d4ed8;
    padding: 0.3rem 0.8rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .kw-pill:hover {
    background: #1d4ed8;
    color: #ffffff;
  }
</style>
