---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import StampWatermark from '../components/StampWatermark.astro';
import RightNav from '../components/RightNav.astro';
import { getCollection } from 'astro:content';

// Fetch posts and sort by pubDate desc, with pinned posts first
const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => {
  if (a.data.isPinned && !b.data.isPinned) return -1;
  if (!a.data.isPinned && b.data.isPinned) return 1;
  return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});

const latestPosts = sortedPosts.slice(0, 6);
---

<BaseLayout
  title="查房｜每周网络服务巡检与避坑指南"
  description="面向机场代理与网络服务用户的中文评测博客。以周为单位巡查，不让断流蒙混过关。提供2026最稳定的机场推荐、性价比机场对比、IEPL专线与BGP中转周巡查报告。"
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-card industrial-box-dark">
        <div class="hero-status-bar">
          <span class="status-indicator-light blinking"></span>
          <span class="status-text font-mono">宿管已上线，本周例行巡楼中。</span>
          <span class="status-time font-mono">CYCLE: 2026年第40周巡查</span>
        </div>

        <div class="hero-main-content">
          <div class="title-group">
            <h1 class="hero-title">开门，查房了。</h1>
            <p class="hero-subtitle">白天全绿不算数，一周 7×24 小时扛得住才算数。</p>
          </div>
          <div class="hero-stamp-wrapper">
            <StampWatermark text="查房了·突击取证专用章" subText="周巡查合格" size="lg" />
          </div>
        </div>

        <p class="hero-intro">
          记录网络服务在每周例行巡检中的公开测试与体验观察。拒绝虚标与口头承诺，以周为单位巡查，用全周 MTR 丢包率、TCP 延迟与开播速度说话。面向机场代理用户，从小白到大神都能找到需要的实测卷宗。
        </p>

        <div class="hero-actions">
          <a href="#patrol-posts" class="btn-primary">
            🔑 领取查房钥匙串
          </a>
          <a href="/handbook" class="btn-secondary">
            📖 查阅防坑手册
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Body Grid -->
  <div class="container">
    <div class="index-content-layout">
      <!-- Left Main Column -->
      <div class="index-main-column">
        <!-- Section: Three Category Cards -->
        <section class="category-cards-section">
          <h2 class="section-title">
            <span class="title-icon">📂</span> 巡楼分类卷宗
          </h2>
          <div class="category-grid">
            <CategoryCard
              title="当场抓包"
              description="每周例行巡查，数据不说谎。"
              href="/category/zhuabao"
              badge="突击抓包"
              badgeType="red"
            />
            <CategoryCard
              title="模范寝室"
              description="长期稳定、表现优异的服务记录。"
              href="/category/mofan"
              badge="免检通报"
              badgeType="dark"
            />
            <CategoryCard
              title="没收作案工具"
              description="异常断流、夸大宣传与避坑档案。"
              href="/category/meishou"
              badge="拉闸避坑"
              badgeType="red"
            />
          </div>
        </section>

        <!-- Section: Latest Patrol Posts -->
        <section id="patrol-posts" class="posts-section">
          <div class="section-header">
            <h2 class="section-title">
              <span class="title-icon">📝</span> 最新巡楼纪要
            </h2>
            <a href="/posts" class="view-all-link">查看全部卷宗 ({allPosts.length}) ➔</a>
          </div>

          <div class="posts-list">
            {latestPosts.map((post) => (
              <ArticleCard
                title={post.data.title}
                description={post.data.description}
                slug={post.slug}
                date={post.data.pubDate.toISOString().split('T')[0]}
                category={post.data.category}
                verdict={post.data.verdict}
                isPinned={post.data.isPinned}
              />
            ))}
          </div>
        </section>

        <!-- Section: SEO / GEO Keyword Guide Banner -->
        <section class="seo-guide-banner industrial-box">
          <h3>🔍 宿管避坑指南与关键词检索</h3>
          <p>
            查找 <strong>2026最稳定的机场</strong>、<strong>性价比机场推荐</strong>、<strong>机场代理选购</strong> 或是解决周巡断流卡顿？宿管已为你分类归档：
          </p>
          <div class="keyword-pill-group">
            <a href="/posts" class="kw-pill">机场代理实测</a>
            <a href="/category/mofan" class="kw-pill">2026最稳定的机场</a>
            <a href="/handbook" class="kw-pill">性价比机场避坑指南</a>
            <a href="/category/zhuabao" class="kw-pill">每周巡查丢包抓包</a>
            <a href="/about" class="kw-pill">查房博客评测标准</a>
          </div>
        </section>
      </div>

      <!-- Right Sidebar Column -->
      <aside class="index-sidebar-column">
        <RightNav activeId="01" title="⚡ 热门机场速览" />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .index-content-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 992px) {
    .index-content-layout {
      grid-template-columns: 1fr 320px;
    }
  }

  .index-sidebar-column {
    position: sticky;
    top: 5rem;
  }

  .hero-section {
    margin-bottom: 2.5rem;
  }

  .hero-card {
    border-width: 3px;
  }

  .hero-status-bar {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    border-bottom: 1.5px dashed #444;
    padding-bottom: 0.8rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
  }

  .status-indicator-light {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
    display: inline-block;
  }

  .status-indicator-light.blinking {
    animation: blink 1.5s infinite ease-in-out;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .status-text {
    color: #ffffff;
    font-weight: 700;
  }

  .status-time {
    color: var(--accent-red);
    margin-left: auto;
  }

  .hero-main-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .hero-title {
    font-size: 3rem;
    color: #ffffff;
    letter-spacing: -1px;
    margin-bottom: 0.4rem;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--accent-red);
    font-weight: 800;
  }

  .hero-intro {
    font-size: 1.05rem;
    color: #dddddd;
    line-height: 1.7;
    max-width: 800px;
    margin-bottom: 1.5rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    background: var(--accent-red);
    color: #ffffff;
    font-weight: 900;
    font-size: 1.05rem;
    padding: 0.75rem 1.5rem;
    text-decoration: none;
    border: 2px solid #ffffff;
    box-shadow: 4px 4px 0px #000000;
    transition: all 0.15s ease;
  }

  .btn-primary:hover {
    background: #b81d1d;
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0px #000000;
    color: #ffffff;
  }

  .btn-secondary {
    background: var(--bg-surface);
    color: var(--text-main);
    font-weight: 800;
    font-size: 1.05rem;
    padding: 0.75rem 1.5rem;
    text-decoration: none;
    border: 2px solid #ffffff;
    box-shadow: 4px 4px 0px #000000;
    transition: all 0.15s ease;
  }

  .btn-secondary:hover {
    background: #e5e3da;
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0px #000000;
  }

  .index-body-grid {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .section-title {
    margin-top: 0;
    margin-bottom: 1.25rem;
    font-size: 1.6rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .view-all-link {
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--accent-red);
  }

  .seo-guide-banner {
    background: #e8e5db;
    margin-top: 1rem;
  }

  .seo-guide-banner h3 {
    margin-top: 0;
    font-size: 1.2rem;
  }

  .keyword-pill-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .kw-pill {
    background: var(--bg-surface);
    color: var(--text-main);
    border: 1.5px solid var(--border-thick);
    padding: 0.3rem 0.7rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    font-family: var(--font-mono);
  }

  .kw-pill:hover {
    background: var(--accent-red);
    color: #ffffff;
  }

  @media (max-width: 768px) {
    .hero-title { font-size: 2.2rem; }
    .hero-subtitle { font-size: 1.1rem; }
    .hero-stamp-wrapper { display: none; }
  }
</style>
