---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import StampWatermark from '../components/StampWatermark.astro';
import RightNav from '../components/RightNav.astro';
import { getCollection } from 'astro:content';

// Fetch all posts
const allPosts = await getCollection('posts');

// 1. Pinned posts first
const pinnedPosts = allPosts.filter(p => p.data.isPinned);

// 2. ShenXing Speed post (神行加速) as #1 non-pinned post
const shenxingPost = allPosts.find(p => p.slug === '14-shenxing-jiasu-iepl-premium-review');

// Pool of remaining candidates excluding pinned and Shenxing
const pool = allPosts.filter(p => !p.data.isPinned && p.slug !== '14-shenxing-jiasu-iepl-premium-review');

// Ensure EVERY category (zhuabao, meishou, mofan, tongbao) has representation
const categories = ['zhuabao', 'meishou', 'mofan', 'tongbao'];
const guaranteedPosts: typeof pool = [];

categories.forEach(cat => {
  const isCoveredInTop = pinnedPosts.some(p => p.data.category === cat) || (shenxingPost && shenxingPost.data.category === cat);
  if (!isCoveredInTop) {
    const catCandidates = pool.filter(p => p.data.category === cat && !guaranteedPosts.includes(p));
    if (catCandidates.length > 0) {
      // Pick one randomly
      const picked = catCandidates[Math.floor(Math.random() * catCandidates.length)];
      guaranteedPosts.push(picked);
    }
  }
});

// Randomly shuffle remaining candidates
const remainingPool = pool.filter(p => !guaranteedPosts.includes(p));
const shuffledRemaining = [...remainingPool].sort(() => 0.5 - Math.random());

// Assemble final homepage list: [Pinned...] -> [ShenXing Speed] -> [Category Guaranteed...] -> [Shuffled Rest]
const latestPosts = [
  ...pinnedPosts,
  ...(shenxingPost ? [shenxingPost] : []),
  ...guaranteedPosts,
  ...shuffledRemaining
].slice(0, 8);
---

<BaseLayout
  title="VPN查房｜每周网络服务巡检与避坑指南"
  description="面向 VPN、机场代理与网络服务用户的中文评测博客。以周为单位巡查，不让断流蒙混过关。提供2026最稳定的 VPN / 机场推荐、性价比服务对比、IEPL专线与BGP中转周巡查报告。"
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-card industrial-box-dark">
        <div class="hero-status-bar">
          <span class="status-indicator-light blinking"></span>
          <span class="status-text font-mono">宿管已上线，本周例行巡楼中。</span>
        </div>

        <div class="hero-main-content">
          <div class="title-group">
            <h1 class="hero-title">开门，VPN查房了。</h1>
            <p class="hero-subtitle">白天全绿不算数，一周 7×24 小时扛得住才算数。</p>
          </div>
          <div class="hero-stamp-wrapper">
            <StampWatermark text="VPN查房了·突击取证专用章" subText="周巡查合格" size="lg" />
          </div>
        </div>

        <p class="hero-intro">
          记录网络服务在每周例行巡检中的公开测试与体验观察。拒绝虚标与口头承诺，以周为单位巡查，用全周 MTR 丢包率、TCP 延迟与开播速度说话。面向机场代理用户，从小白到大神都能找到需要的实测卷宗。
        </p>

        <div class="hero-actions">
          <a href="/category/mofan" class="btn-primary">
            🔑 领取查房钥匙串
          </a>
          <a href="/handbook" class="btn-secondary">
            📖 查阅防坑手册
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Body -->
  <div class="container index-body-grid">
    <div class="page-layout-grid">
      <!-- Left Main Column -->
      <div class="main-column">
        <!-- Section: Four Category Cards -->
        <section class="category-cards-section">
          <h2 class="section-title">
            <span class="title-icon">📂</span> 巡楼分类卷宗
          </h2>
          <div class="category-grid">
            <CategoryCard
              title="当场抓包"
              description="每周例行巡查，数据不说谎。"
              href="/category/zhuabao"
              badge="突击抓包"
              badgeType="red"
            />
            <CategoryCard
              title="模范寝室"
              description="长期稳定、表现优异的服务记录。"
              href="/category/mofan"
              badge="免检通报"
              badgeType="dark"
            />
            <CategoryCard
              title="没收作案工具"
              description="异常断流、夸大宣传与避坑档案。"
              href="/category/meishou"
              badge="拉闸避坑"
              badgeType="red"
            />
            <CategoryCard
              title="入住教程"
              description="零基础小白教程，Clash与小火箭全攻略。"
              href="/category/jiaocheng"
              badge="新手指南"
              badgeType="dark"
            />
          </div>
        </section>

        <!-- Section: Latest Patrol Posts -->
        <section id="patrol-posts" class="posts-section">
          <div class="section-header">
            <h2 class="section-title">
              <span class="title-icon">📝</span> 最新巡楼纪要
            </h2>
            <a href="/posts" class="view-all-link">查看全部卷宗 ({allPosts.length}) ➔</a>
          </div>

          <div class="posts-list">
            {latestPosts.map((post) => (
              <ArticleCard
                title={post.data.title}
                description={post.data.description}
                slug={post.slug}
                date={post.data.pubDate.toISOString().split('T')[0]}
                category={post.data.category}
                verdict={post.data.verdict}
                badge={post.data.badge}
                isPinned={post.data.isPinned}
              />
            ))}
          </div>
        </section>

        <!-- Section: SEO / GEO Keyword Guide Banner -->
        <section class="seo-guide-banner industrial-box">
          <h3>🔍 宿管避坑指南与关键词检索</h3>
          <p>
            查找 <strong>2026最稳定的机场</strong>、<strong>性价比机场推荐</strong>、<strong>机场代理选购</strong> 或是解决周巡断流卡顿？宿管已为你分类归档：
          </p>
          <div class="keyword-pill-group">
            <a href="/posts" class="kw-pill">机场代理实测</a>
            <a href="/category/mofan" class="kw-pill">2026最稳定的机场</a>
            <a href="/handbook" class="kw-pill">性价比机场避坑指南</a>
            <a href="/category/zhuabao" class="kw-pill">每周巡查丢包抓包</a>
            <a href="/about" class="kw-pill">查房博客评测标准</a>
          </div>
        </section>
      </div>

      <!-- Right Sidebar Column: Structured Right Navigation -->
      <aside class="right-sidebar-column">
        <RightNav activeId="01" title="⚡ 热门机场速览" />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .hero-section {
    margin-bottom: 2.5rem;
  }

  .hero-card {
    border-width: 3px;
  }

  .hero-status-bar {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    border-bottom: 1.5px dashed #444;
    padding-bottom: 0.8rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
  }

  .status-indicator-light {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
    display: inline-block;
  }

  .status-indicator-light.blinking {
    animation: blink 1.5s infinite ease-in-out;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .status-text {
    color: #ffffff;
    font-weight: 700;
  }

  .status-time {
    color: var(--accent-red);
    margin-left: auto;
  }

  .hero-main-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .hero-title {
    font-size: 3rem;
    color: #ffffff;
    letter-spacing: -1px;
    margin-bottom: 0.4rem;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--accent-red);
    font-weight: 800;
  }

  .hero-intro {
    font-size: 1.05rem;
    color: #dddddd;
    line-height: 1.7;
    max-width: 800px;
    margin-bottom: 1.5rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-primary, .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background: var(--accent-red);
    color: #ffffff;
    border: 2px solid #ffffff;
    box-shadow: 3px 3px 0px #ffffff;
  }

  .btn-primary:hover {
    background: var(--accent-red-hover);
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px #ffffff;
    color: #ffffff;
  }

  .btn-secondary {
    background: transparent;
    color: #ffffff;
    border: 2px solid #ffffff;
  }

  .btn-secondary:hover {
    background: #ffffff;
    color: var(--text-main);
  }

  .index-body-grid {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.5rem;
    margin-bottom: 1.25rem;
    border-bottom: 2px solid var(--border-thick);
    padding-bottom: 0.4rem;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  /* Two-column Layout: Main on Left, RightNav on Right */
  .page-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 992px) {
    .page-layout-grid {
      grid-template-columns: 1fr 320px;
      gap: 3rem;
    }
    .right-sidebar-column {
      margin-left: 1.5rem;
      position: sticky;
      top: 5rem;
    }
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.25rem;
    border-bottom: 2px solid var(--border-thick);
    padding-bottom: 0.4rem;
  }

  .section-header .section-title {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .view-all-link {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--accent-red);
    text-decoration: none;
  }

  .view-all-link:hover {
    text-decoration: underline;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .seo-guide-banner {
    background: #eef2ff;
    border-color: #1d4ed8;
    box-shadow: 4px 4px 0px #1d4ed8;
  }

  .seo-guide-banner h3 {
    margin-top: 0;
    color: #1e3a8a;
  }

  .seo-guide-banner p {
    color: #334155;
    margin-bottom: 1rem;
  }

  .keyword-pill-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .kw-pill {
    background: #ffffff;
    border: 1.5px solid #1d4ed8;
    color: #1d4ed8;
    padding: 0.3rem 0.8rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .kw-pill:hover {
    background: #1d4ed8;
    color: #ffffff;
  }
</style>
