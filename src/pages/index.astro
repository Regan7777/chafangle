---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import StampWatermark from '../components/StampWatermark.astro';
import RightNav from '../components/RightNav.astro';
import { getCollection } from 'astro:content';

// Fetch all posts
const allPosts = await getCollection('posts');

// 6 Core Featured Airport Reviews in strict priority order:
// 1. 神行加速 -> 2. 大佬云 -> 3. 榴莲云 -> 4. 云界线 -> 5. 环球梯 -> 6. 闪电鼠
const coreSlugs = [
  '14-shenxing-jiasu-iepl-premium-review',
  '15-dalaoyun-bgp-high-value-review',
  '17-liulianyun-native-ip-unlock-review',
  '19-yunjiexian-pure-iepl-dedicated-review',
  '18-huanqiuti-global-business-review',
  '16-shandianshu-fast-latency-review',
];

const corePosts = coreSlugs
  .map(slug => allPosts.find(p => p.slug === slug))
  .filter((p): p is (typeof allPosts)[0] => Boolean(p));

// Other posts sorted by pubDate
const otherPosts = allPosts
  .filter(p => !coreSlugs.includes(p.slug))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Assemble final homepage list: 6 Core Featured Airports first, followed by others
const latestPosts = [
  ...corePosts,
  ...otherPosts,
].slice(0, 10);
---

<BaseLayout
  title="2026机场推荐｜每周网络服务巡检与避坑指南"
  description="面向 VPN、机场代理与网络服务用户的中文评测博客。以周为单位巡查，不让断流蒙混过关。提供2026最稳定的 VPN / 机场推荐、性价比服务对比、IEPL专线与BGP中转周巡查报告。"
>
  <!-- Hero Section with Security Cat Mascot & 4-Panel Comic Strip -->
  <section class="hero-section">
    <div class="container">
      <!-- Cat Hero Banner Card (宿管猫主图卡片) -->
      <div class="hero-cat-banner-card">
        <!-- Visual Presentation of Mockup Banner -->
        <div class="hero-cat-visual-wrapper">
          <img 
            src="/images/hero-card-perfect.png" 
            alt="2026机场推荐 - 宿管猫周巡查" 
            class="hero-cat-banner-image"
            width="976"
            height="398"
            loading="eager"
            fetchpriority="high"
          />
          
          <!-- Interactive Clickable Hotspots overlaying the 2 buttons in the artwork -->
          <div class="hero-hotspots-layer">
            <a 
              href="/category/mofan" 
              class="hero-hotspot-btn hotspot-key-btn" 
              title="🔑 领取查房钥匙串（2026主推机场）"
              aria-label="领取查房钥匙串"
            ></a>
            <a 
              href="/handbook" 
              class="hero-hotspot-btn hotspot-handbook-btn" 
              title="📖 查阅防坑手册"
              aria-label="查阅防坑手册"
            ></a>
          </div>
        </div>

        <!-- Semantic SEO Information (Visually hidden for screen readers & search engines) -->
        <div class="sr-only">
          <h1>2026机场推荐</h1>
          <p>白天全绿不算数，一周 7×24 小时扛得住才算数。</p>
          <p>
            记录网络服务在每周例行巡检中的公开测试与体验观察。拒绝虚标与口头承诺，以周为单位巡查，用全周 MTR 丢包率、TCP 延迟与开播速度说话。面向机场代理用户，从小白到大神都能找到需要的实测卷宗。核心主推机场全线不限设备使用数量。
          </p>
          <a href="/category/mofan">领取查房钥匙串</a>
          <a href="/handbook">查阅防坑手册</a>
        </div>

        <!-- Responsive Mobile Actions (displays on small mobile screens for convenient tapping) -->
        <div class="hero-mobile-actions">
          <a href="/category/mofan" class="btn-primary">
            🔑 领取查房钥匙串
          </a>
          <a href="/handbook" class="btn-secondary">
            📖 查阅防坑手册
          </a>
        </div>
      </div>

      <!-- 4-Panel Security Cat Comic Strip (四格宿管猫查房漫画) -->
      <div class="comic-strip-wrapper">
        <div class="comic-panels-grid">
          <a href="/category/zhuabao" class="comic-panel-card" title="日常巡逻：宿管上班，今晚突查！">
            <img 
              src="/images/comic-panel-1.png" 
              alt="日常巡查：宿管上班，今晚突查！" 
              class="comic-panel-img"
              width="238" 
              height="256"
              loading="lazy" 
            />
          </a>
          <a href="/category/zhuabao" class="comic-panel-card" title="发现异常（抓包）：逮到了！">
            <img 
              src="/images/comic-panel-2.png" 
              alt="发现异常（抓包）：逮到了！" 
              class="comic-panel-img"
              width="238" 
              height="256"
              loading="lazy" 
            />
          </a>
          <a href="/category/mofan" class="comic-panel-card" title="盖章通过：安全通过！">
            <img 
              src="/images/comic-panel-3.png" 
              alt="盖章通过：安全通过！" 
              class="comic-panel-img"
              width="238" 
              height="256"
              loading="lazy" 
            />
          </a>
          <a href="/category/mofan" class="comic-panel-card" title="提供钥匙：拿好，门禁卡！全线不限设备使用数量">
            <img 
              src="/images/comic-panel-4.png" 
              alt="提供钥匙：拿好，门禁卡！" 
              class="comic-panel-img"
              width="240" 
              height="256"
              loading="lazy" 
            />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Body -->
  <div class="container index-body-grid">
    <div class="page-layout-grid">
      <!-- Left Main Column -->
      <div class="main-column">
        <!-- Section: Four Category Cards -->
        <section class="category-cards-section">
          <h2 class="section-title">
            <span class="title-icon">📂</span> 巡楼分类卷宗
          </h2>
          <div class="category-grid">
            <CategoryCard
              title="机场评测"
              description="每周例行巡查，数据不说谎。实测丢包与延迟。"
              href="/category/zhuabao"
              badge="突击抓包"
              badgeType="red"
            />
            <CategoryCard
              title="机场推荐"
              description="长期稳定、表现优异的服务记录。五星推荐。"
              href="/category/mofan"
              badge="五星推荐"
              badgeType="dark"
            />
            <CategoryCard
              title="跑路机场"
              description="异常断流、夸大宣传与跑路避坑档案。"
              href="/category/meishou"
              badge="拉闸避坑"
              badgeType="red"
            />
            <CategoryCard
              title="入住教程"
              description="零基础小白教程，Clash与小火箭全攻略。"
              href="/category/jiaocheng"
              badge="新手指南"
              badgeType="dark"
            />
          </div>
        </section>

        <!-- Section: Latest Patrol Posts -->
        <section id="patrol-posts" class="posts-section">
          <div class="section-header">
            <h2 class="section-title">
              <span class="title-icon">📝</span> 最新巡楼纪要
            </h2>
            <a href="/posts" class="view-all-link">查看全部卷宗 ({allPosts.length}) ➔</a>
          </div>

          <div class="posts-list">
            {latestPosts.map((post) => (
              <ArticleCard
                title={post.data.title}
                description={post.data.description}
                slug={post.slug}
                date={post.data.pubDate.toISOString().split('T')[0]}
                category={post.data.category}
                verdict={post.data.verdict}
                badge={post.data.badge}
                isPinned={post.data.isPinned}
              />
            ))}
          </div>
        </section>

        <!-- Section: SEO / GEO Keyword Guide Banner -->
        <section class="seo-guide-banner industrial-box">
          <h3>🔍 宿管避坑指南与关键词检索</h3>
          <p>
            查找 <strong>2026最稳定的机场</strong>、<strong>性价比机场推荐</strong>、<strong>机场代理选购</strong> 或是解决周巡断流卡顿？宿管已为你分类归档：
          </p>
          <div class="keyword-pill-group">
            <a href="/posts" class="kw-pill">机场代理实测</a>
            <a href="/category/mofan" class="kw-pill">2026最稳定的机场</a>
            <a href="/handbook" class="kw-pill">性价比机场避坑指南</a>
            <a href="/category/zhuabao" class="kw-pill">每周巡查丢包抓包</a>
            <a href="/about" class="kw-pill">查房博客评测标准</a>
          </div>
        </section>
      </div>

      <!-- Right Sidebar Column: Structured Right Navigation -->
      <aside class="right-sidebar-column">
        <RightNav activeId="01" title="⚡ 热门机场速览" />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .hero-section {
    margin-bottom: 2.5rem;
  }

  /* Cat Hero Banner Card */
  .hero-cat-banner-card {
    background: #111113;
    border: 3px solid #000000;
    box-shadow: 6px 6px 0px #000000;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  .hero-cat-visual-wrapper {
    position: relative;
    width: 100%;
    line-height: 0;
  }

  .hero-cat-banner-image {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 976 / 398;
    object-fit: cover;
  }

  /* Hotspots Overlay for Artwork Buttons */
  .hero-hotspots-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-hotspot-btn {
    position: absolute;
    pointer-events: auto;
    border-radius: 4px;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease, outline 0.15s ease;
  }

  /* Red Button: 🔑 领取查房钥匙串 */
  .hotspot-key-btn {
    left: 3.79%;
    top: 67.58%;
    width: 16.18%;
    height: 10.05%;
  }

  .hotspot-key-btn:hover {
    outline: 2.5px solid #ffffff;
    box-shadow: 0 0 14px rgba(220, 38, 38, 0.9);
    transform: translateY(-2px);
  }

  /* Secondary Button: 📖 查阅防坑手册 */
  .hotspot-handbook-btn {
    left: 20.49%;
    top: 66.58%;
    width: 16.9%;
    height: 12.3%;
  }

  .hotspot-handbook-btn:hover {
    outline: 2.5px solid #ffffff;
    box-shadow: 0 0 14px rgba(255, 255, 255, 0.85);
    transform: translateY(-2px);
  }

  /* Screen Reader Utility */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  /* Responsive Mobile Actions */
  .hero-mobile-actions {
    display: none;
  }

  @media (max-width: 640px) {
    .hero-mobile-actions {
      display: flex;
      gap: 0.75rem;
      padding: 0.85rem 1rem;
      background: #18181b;
      justify-content: center;
      flex-wrap: wrap;
      border-top: 2px dashed #333338;
    }
    .hero-mobile-actions .btn-primary,
    .hero-mobile-actions .btn-secondary {
      font-size: 0.88rem;
      padding: 0.6rem 1rem;
    }
  }

  /* 4-Panel Security Cat Comic Strip (四格宿管猫巡楼漫画) */
  .comic-strip-wrapper {
    margin-top: 1.25rem;
    margin-bottom: 2rem;
  }

  .comic-panels-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 768px) {
    .comic-panels-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.85rem;
    }
  }

  @media (max-width: 480px) {
    .comic-panels-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.6rem;
    }
  }

  .comic-panel-card {
    display: block;
    background: #ffffff;
    border: 2px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 4px;
    overflow: hidden;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease, border-color 0.2s ease;
    text-decoration: none;
  }

  .comic-panel-card:hover {
    transform: translateY(-4px);
    box-shadow: 5px 5px 0px var(--accent-red);
    border-color: var(--accent-red);
  }

  .comic-panel-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .btn-primary, .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background: var(--accent-red);
    color: #ffffff;
    border: 2px solid #ffffff;
    box-shadow: 3px 3px 0px #ffffff;
  }

  .btn-primary:hover {
    background: var(--accent-red-hover);
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px #ffffff;
    color: #ffffff;
  }

  .btn-secondary {
    background: transparent;
    color: #ffffff;
    border: 2px solid #ffffff;
  }

  .btn-secondary:hover {
    background: #ffffff;
    color: var(--text-main);
  }

  .index-body-grid {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.5rem;
    margin-bottom: 1.25rem;
    border-bottom: 2px solid var(--border-thick);
    padding-bottom: 0.4rem;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  /* Two-column Layout: Main on Left, RightNav on Right */
  .page-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 992px) {
    .page-layout-grid {
      grid-template-columns: 1fr 320px;
      gap: 3rem;
    }
    .right-sidebar-column {
      margin-left: 1.5rem;
      position: sticky;
      top: 5rem;
    }
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.25rem;
    border-bottom: 2px solid var(--border-thick);
    padding-bottom: 0.4rem;
  }

  .section-header .section-title {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .view-all-link {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--accent-red);
    text-decoration: none;
  }

  .view-all-link:hover {
    text-decoration: underline;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .seo-guide-banner {
    background: #eef2ff;
    border-color: #1d4ed8;
    box-shadow: 4px 4px 0px #1d4ed8;
  }

  .seo-guide-banner h3 {
    margin-top: 0;
    color: #1e3a8a;
  }

  .seo-guide-banner p {
    color: #334155;
    margin-bottom: 1rem;
  }

  .keyword-pill-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .kw-pill {
    background: #ffffff;
    border: 1.5px solid #1d4ed8;
    color: #1d4ed8;
    padding: 0.3rem 0.8rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .kw-pill:hover {
    background: #1d4ed8;
    color: #ffffff;
  }
</style>
