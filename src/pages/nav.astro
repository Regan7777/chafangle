</BaseLayout>

<style>
  .nav-portal-page {
    max-width: 1200px;
    margin: 0 auto;
    padding-top: 1.5rem;
    padding-bottom: 3.5rem;
  }

  .page-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 992px) {
    .page-layout-grid {
      grid-template-columns: 1fr 320px;
      gap: 3rem;
    }
    .right-sidebar-column {
      position: sticky;
      top: 5rem;
    }
  }

  .page-header {
    background: #ffffff;
    padding: 1.8rem;
