---
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PatrolUncle from '../components/PatrolUncle.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  image?: string;
  type?: 'website' | 'article';
  publishDate?: Date;
  updatedDate?: Date;
  author?: string;
  showPatrolCat?: boolean;
}

const {
  title,
  description,
  keywords,
  image,
  type = 'website',
  publishDate,
  updatedDate,
  author,
  showPatrolCat = true,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <Seo
      title={title}
      description={description}
      keywords={keywords}
      image={image}
      type={type}
      publishDate={publishDate}
      updatedDate={updatedDate}
      author={author}
    />
  </head>
  <body>
    <Header />
    <main id="main-content" class="main-wrapper">
      <slot />
    </main>
    <!-- Interactive Patrol Uncle Floating Button -->
    {showPatrolCat && <PatrolUncle />}
    <Footer />
  </body>
</html>

<style>
  .main-wrapper {
    flex: 1;
    padding-top: 1.5rem;
    padding-bottom: 3rem;
  }
</style>
