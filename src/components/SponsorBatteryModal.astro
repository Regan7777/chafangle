---
---

<div class="interaction-section">
  <!-- Comments Notice Banner -->
  <div class="comments-notice-bar">
    <div class="notice-icon">📢</div>
    <div class="notice-text">
      <strong>评论区管规：</strong>请保持安静，禁止在走廊大声喧哗。有疑问或周度测试反馈请据实列出具体节点与测试周期。
    </div>
  </div>

  <!-- Sponsor Battery Action Box -->
  <div class="sponsor-battery-card">
    <div class="battery-illustration">
      <span class="battery-icon">🔋🔋</span>
      <span class="battery-label">AA 1.5V 周巡专用电池</span>
    </div>
    <div class="sponsor-content">
      <h4 class="sponsor-title">周巡路途长，手电筒不能没电</h4>
      <p class="sponsor-desc">
        如果你觉得本周的巡查纪要帮你避开了虚标断流坑，欢迎给宿管大爷赞助两节手电筒电池。
      </p>
      <button id="sponsor-btn" class="sponsor-action-btn">
        🔋 给宿管大爷赞助两节手电筒电池
      </button>
    </div>
  </div>

  <!-- Interactive Modal -->
  <div id="sponsor-modal" class="modal-overlay hidden">
    <div class="modal-box">
      <div class="modal-header">
        <h3>⚡ 电池已充能！感谢赞助</h3>
        <button id="close-modal-btn" class="close-btn">&times;</button>
      </div>
      <div class="modal-body">
        <p class="modal-power-status">
          🔋 手电筒电量：<strong style="color: #16a34a;">100% (每周高强周巡模式开启)</strong>
        </p>
        <p>宿管已收到你的电池心意！本周例行巡检将继续带上手电筒和测速仪，为你突击巡检整栋楼的服务表现！</p>
        <div class="qr-mock">
          <div class="qr-box">[ ⚡ 周巡查电池备用箱 ⚡ ]</div>
          <p class="qr-sub">（感谢支持公开免费、无赞助恰饭的网络周巡实测！）</p>
        </div>
      </div>
      <div class="modal-footer">
        <button id="confirm-modal-btn" class="modal-confirm-btn">收下收据，继续围观</button>
      </div>
    </div>
  </div>
</div>

<script>
  const btn = document.getElementById('sponsor-btn');
  const modal = document.getElementById('sponsor-modal');
  const closeBtn = document.getElementById('close-modal-btn');
  const confirmBtn = document.getElementById('confirm-modal-btn');

  if (btn && modal && closeBtn && confirmBtn) {
    btn.addEventListener('click', () => {
      modal.classList.remove('hidden');
    });

    const closeModal = () => {
      modal.classList.add('hidden');
    };

    closeBtn.addEventListener('click', closeModal);
    confirmBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  }
</script>

<style>
  .interaction-section {
    margin: 3rem 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .comments-notice-bar {
    background: #e2dfd5;
    border: 2px solid var(--border-thick);
    padding: 0.9rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    box-shadow: 3px 3px 0px var(--border-thick);
  }

  .notice-icon {
    font-size: 1.4rem;
  }

  .notice-text {
    font-size: 0.95rem;
    color: var(--text-main);
  }

  .sponsor-battery-card {
    background: var(--bg-dark);
    color: #ffffff;
    border: 3px solid var(--border-thick);
    box-shadow: 5px 5px 0px var(--accent-red);
    padding: 1.5rem;
    display: flex;
    gap: 1.5rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .battery-illustration {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #25252c;
    padding: 1rem 1.25rem;
    border: 2px solid #444;
    min-width: 140px;
  }

  .battery-icon {
    font-size: 2.2rem;
  }

  .battery-label {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: #aaa;
    margin-top: 0.3rem;
  }

  .sponsor-content {
    flex: 1;
    min-width: 260px;
  }

  .sponsor-title {
    color: #ffffff;
    font-size: 1.2rem;
    margin: 0 0 0.5rem 0;
  }

  .sponsor-desc {
    color: #cccccc;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .sponsor-action-btn {
    background: var(--accent-red);
    color: #ffffff;
    border: 2px solid #ffffff;
    padding: 0.6rem 1.2rem;
    font-weight: 900;
    font-size: 0.95rem;
    cursor: pointer;
    box-shadow: 3px 3px 0px #000000;
    transition: all 0.15s ease;
  }

  .sponsor-action-btn:hover {
    background: #b81d1d;
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0px #000000;
  }

  /* Modal Styling */
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.75);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
    padding: 1rem;
  }

  .modal-overlay.hidden {
    display: none;
  }

  .modal-box {
    background: var(--bg-primary);
    border: 3px solid var(--border-thick);
    box-shadow: 8px 8px 0px #000000;
    width: 100%;
    max-width: 480px;
    padding: 1.5rem;
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid var(--border-thick);
    padding-bottom: 0.75rem;
    margin-bottom: 1rem;
  }

  .modal-header h3 {
    margin: 0;
    font-size: 1.2rem;
  }

  .close-btn {
    background: none;
    border: none;
    font-size: 1.6rem;
    font-weight: 900;
    cursor: pointer;
    line-height: 1;
  }

  .modal-body p {
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }

  .qr-mock {
    background: #ffffff;
    border: 2px dashed var(--border-thick);
    padding: 1.25rem;
    text-align: center;
    margin: 1rem 0;
  }

  .qr-box {
    font-family: var(--font-mono);
    font-weight: 900;
    color: var(--accent-red);
    font-size: 1.1rem;
  }

  .qr-sub {
    font-size: 0.8rem;
    color: #666;
    margin-top: 0.5rem;
  }

  .modal-confirm-btn {
    background: var(--border-thick);
    color: #ffffff;
    border: none;
    padding: 0.6rem 1.2rem;
    font-weight: 800;
    width: 100%;
    cursor: pointer;
  }

  .modal-confirm-btn:hover {
    background: var(--accent-red);
  }
</style>
