---

<!-- Desktop Pet Cat: real mascot image, walks only in bottom-right corner -->
<div id="desktop-pet-cat" role="button" tabindex="0" aria-label="宿管猫巡查 - 点击互动">
  <!-- Speech bubble -->
  <div id="cat-bubble" class="cat-bubble hidden">
    <span id="cat-bubble-text">喵～今晚查房！白天全绿不算数 🔦</span>
  </div>

  <!-- Real mascot image -->
  <div class="cat-img-wrapper">
    <img
      id="cat-mascot-img"
      src="/images/cat-mascot-hd-transparent.png"
      alt="宿管巡查猫"
      width="96"
      height="96"
      draggable="false"
    />
  </div>

  <!-- Shadow -->
  <div class="cat-shadow"></div>
</div>

<script>
  (function () {
    const pet    = document.getElementById('desktop-pet-cat') as HTMLElement;
    const catImg = document.getElementById('cat-mascot-img') as HTMLImageElement;
    const bubble    = document.getElementById('cat-bubble') as HTMLElement;
    const bubbleText = document.getElementById('cat-bubble-text') as HTMLElement;

    if (!pet || !catImg) return;

    /* ── QUOTES ── */
    const meows = [
      '喵～今晚查房！白天全绿不算数 🔦',
      '🐾 抓包现场！谁在偷懒断流？',
      '🔑 叮当～钥匙串来了，开门！',
      '喵！发现劣质线路，当场没收！',
      '🚨 突击抽查！延迟跑到300ms？',
      '😼 宿管猫盖章：本周全线合格！',
      '🐱 防坑手册必看，月付最安全！',
    ];
    let lastMeow = -1;
    function randomMeow() {
      let i;
      do { i = Math.floor(Math.random() * meows.length); } while (i === lastMeow);
      lastMeow = i;
      return meows[i];
    }

    /* ── WALK in bottom-right zone only ──
       The cat patrols a short range (120 px) anchored at right edge.
       posX = 0 means cat is at its rightmost resting position;
       posX = maxTravel means it has walked `maxTravel` px to the left of that.
    */
    const CAT_W     = 96;   // px
    const maxTravel = 130;  // px total patrol distance
    const speed     = 0.4;  // px per frame

    let posX    = 0;         // 0..maxTravel (left offset from right anchor)
    let dir     = 1;         // 1 = moving left (increasing posX), -1 = moving right
    let bob     = 0;         // frame counter for bounce
    let bubbleTimer: ReturnType<typeof setTimeout> | null = null;

    function applyTransform() {
      bob++;
      const bobY = Math.sin(bob * 0.22) * 2.2;
      // right anchor: fixed right = 24px, move left by posX
      pet.style.right  = (24 + posX) + 'px';
      pet.style.bottom = (24 + bobY) + 'px';

      // Flip image to face walking direction
      // dir 1 = walking left → face left (normal, the image naturally faces left)
      // dir -1 = walking right → face right (mirror)
      catImg.style.transform = dir === -1 ? 'scaleX(-1)' : 'scaleX(1)';
    }

    function tick() {
      posX += speed * dir;
      if (posX >= maxTravel) { posX = maxTravel; dir = -1; }
      if (posX <= 0)         { posX = 0;          dir =  1; }
      applyTransform();
      requestAnimationFrame(tick);
    }

    // Reset any CSS positioning that may conflict
    pet.style.position = 'fixed';
    pet.style.left     = 'auto';
    pet.style.zIndex   = '9999';
    applyTransform();
    requestAnimationFrame(tick);

    /* ── BUBBLE ── */
    function showBubble() {
      if (!bubble || !bubbleText) return;
      bubbleText.textContent = randomMeow();
      bubble.classList.remove('hidden');
      bubble.classList.add('pop-in');
      if (bubbleTimer) clearTimeout(bubbleTimer);
      bubbleTimer = setTimeout(() => {
        bubble.classList.add('hidden');
        bubble.classList.remove('pop-in');
      }, 3800);
    }

    pet.addEventListener('click', showBubble);
    pet.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); showBubble(); }
    });

    // Occasional random auto-meow
    function scheduleAutoMeow() {
      setTimeout(() => { showBubble(); scheduleAutoMeow(); }, 15000 + Math.random() * 20000);
    }
    scheduleAutoMeow();
  })();
</script>

<style>
  #desktop-pet-cat {
    position: fixed;
    bottom: 24px;
    right: 24px;
    left: auto;
    z-index: 9999;
    cursor: pointer;
    user-select: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 96px;
  }

  /* ── MASCOT IMAGE ── */
  .cat-img-wrapper {
    width: 96px;
    height: 96px;
    position: relative;
  }

  #cat-mascot-img {
    width: 96px;
    height: auto;
    display: block;
    filter: drop-shadow(0 6px 14px rgba(0,0,0,0.45));
    /* walking bob via JS bottom; flip via JS transform */
    transition: transform 0.12s ease;
    image-rendering: crisp-edges;
  }

  /* ── SHADOW ── */
  .cat-shadow {
    width: 60px;
    height: 8px;
    border-radius: 50%;
    background: rgba(0,0,0,0.18);
    filter: blur(4px);
    margin-top: -4px;
    animation: shadowPulse 0.44s ease-in-out infinite alternate;
  }
  @keyframes shadowPulse {
    from { transform: scaleX(0.85); opacity: 0.14; }
    to   { transform: scaleX(1.15); opacity: 0.22; }
  }

  /* ── SPEECH BUBBLE ── */
  .cat-bubble {
    position: absolute;
    bottom: calc(100% + 10px);
    right: 0;
    background: #121214;
    color: #f4f4f5;
    border: 2px solid #ffffff;
    box-shadow: 4px 4px 0px var(--accent-red, #d92626);
    border-radius: 8px;
    padding: 0.55rem 0.85rem;
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.5;
    width: 200px;
    white-space: normal;
    pointer-events: none;
    z-index: 10001;
  }
  .cat-bubble::after {
    content: '';
    position: absolute;
    bottom: -9px;
    right: 20px;
    border-left: 8px solid transparent;
    border-right: 8px solid transparent;
    border-top: 9px solid #121214;
  }
  .cat-bubble.hidden { display: none; }
  .cat-bubble.pop-in {
    animation: catBubbleIn 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes catBubbleIn {
    from { opacity: 0; transform: translateY(8px) scale(0.88); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  @media (max-width: 400px) {
    #desktop-pet-cat { display: none; }
  }
</style>
