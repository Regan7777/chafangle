---
---

<div id="patrol-uncle-widget" class="patrol-uncle-container" role="button" tabindex="0" aria-label="宿管猫 3D 周巡查抓包按钮">
  <!-- 3D Speech Bubble & Stamp Dialog -->
  <div id="uncle-dialog" class="uncle-speech-bubble hidden font-mono">
    <div class="bubble-3d-header">
      <div class="header-tag">
        <span class="status-dot-green"></span>
        <span class="role-title">【宿管猫巡查通报】</span>
      </div>
      <button id="close-dialog-btn" class="bubble-close" aria-label="关闭">&times;</button>
    </div>

    <!-- Speech Text Body -->
    <div id="uncle-speech-text" class="speech-text">
      🐾【喵呜·强光开启】宿管猫猫上线！今晚例行查房，白天全绿不算数，全周7×24小时扛得住才算数！
    </div>

    <!-- Dynamic 3D Stamp Seal Effect -->
    <div class="dialog-stamp-seal">
      查房了·宿管猫印
    </div>

    <div class="bubble-arrow-3d"></div>
  </div>

  <!-- 3D Patrol Stage Container -->
  <div class="patrol-stage-3d">
    <!-- Volumetric 3D Light Cone -->
    <div class="volumetric-light-cone"></div>

    <!-- Floating 3D Badge -->
    <div class="stage-badge-3d">
      <span class="pulse-red-light"></span> 周巡查进行中
    </div>

    <!-- 3D Security Cat Mascot Character (宿管巡查猫模型) -->
    <div class="uncle-character-box-3d">
      <img 
        src="/images/cat-mascot-hd-transparent.png" 
        alt="宿管巡查猫模型" 
        class="cat-mascot-img-3d" 
        width="90" 
        height="105" 
      />
    </div>

    <!-- 3D Stage Platform Base Deck with Hazard Stripes -->
    <div class="stage-platform-base">
      <div class="hazard-stripes"></div>
    </div>
  </div>
</div>

<script>
  // Immersive Security Cat Weekly Dorm Patrol Quotes
  const uncleQuotes = [
    "🐾【喵呜·强光开启】宿管猫猫上线！今晚例行查房，白天全绿不算数，全周7×24小时扛得住才算数！",
    "🔦【肉垫手电筒】本周例行巡查开始！手电筒一照，虚标倍率和假专线当场现原形！",
    "🔑【钥匙串叮当响】走廊不许喧哗！拿着宿管猫钥匙串，6大推荐机场随便连，全线不限设备数量！",
    "🚨【猫爪抓包】本周突击抽查！抓到丢包率飙到40%的劣质机场，当场没收通报！",
    "🏆【盖章通过】核心6大专线机场表现优异，延迟稳定不丢包，本猫亲自盖章认证！",
    "⚡【猫耳雷达】白天千兆、晚上挂水？宿管猫24小时雷达监测，谁也别想蒙混过关！",
    "📋【查房通报】防坑手册必须看！理性消费支持月付，切勿一次性充值长期大额！",
    "🐱【巡楼完毕】打卡巡查完毕！有问题随时戳我，宿管猫为你严守网络大门！"
  ];

  const widget = document.getElementById('patrol-uncle-widget');
  const dialog = document.getElementById('uncle-dialog');
  const speechText = document.getElementById('uncle-speech-text');
  const closeBtn = document.getElementById('close-dialog-btn');

  let lastIndex = -1;

  function getRandomQuote() {
    let nextIndex;
    do {
      nextIndex = Math.floor(Math.random() * uncleQuotes.length);
    } while (nextIndex === lastIndex && uncleQuotes.length > 1);
    lastIndex = nextIndex;
    return uncleQuotes[nextIndex];
  }

  function triggerUncleResponse() {
    if (!dialog || !speechText) return;
    
    speechText.textContent = getRandomQuote();
    dialog.classList.remove('hidden');

    // Trigger 3D Flash Spotlight & Key Jingling Visual Effect
    widget?.classList.add('flashlight-super-spotlight');
    setTimeout(() => {
      widget?.classList.remove('flashlight-super-spotlight');
    }, 600);
  }

  if (widget) {
    widget.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('#close-dialog-btn')) {
        dialog?.classList.add('hidden');
        return;
      }
      triggerUncleResponse();
    });

    widget.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        triggerUncleResponse();
      }
    });
  }

  if (closeBtn) {
    closeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      dialog?.classList.add('hidden');
    });
  }
</script>

<style>
  .patrol-uncle-container {
    position: fixed;
    bottom: 24px;
    left: 24px;
    z-index: 9999;
    cursor: pointer;
    user-select: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    perspective: 800px;
  }

  /* 3D Stage Platform Wrapper */
  .patrol-stage-3d {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform-style: preserve-3d;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .patrol-uncle-container:hover .patrol-stage-3d {
    transform: translateY(-6px) rotateX(6deg) scale(1.06);
  }

  /* 3D Floating Badge */
  .stage-badge-3d {
    position: absolute;
    top: -24px;
    background: #18181b;
    color: #ffffff;
    border: 1.5px solid var(--accent-red);
    box-shadow: 2px 2px 0px #000000;
    padding: 0.15rem 0.5rem;
    font-size: 0.72rem;
    font-weight: 900;
    font-family: var(--font-mono);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
    z-index: 10;
  }

  .pulse-red-light {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-red);
    box-shadow: 0 0 6px var(--accent-red);
    animation: pulseGlow 1.2s infinite ease-in-out;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.3; transform: scale(0.7); }
  }

  /* Volumetric 3D Light Cone Beam */
  .volumetric-light-cone {
    position: absolute;
    left: -140px;
    top: 28px;
    width: 155px;
    height: 90px;
    background: linear-gradient(270deg, rgba(254, 240, 138, 0.75) 0%, rgba(250, 204, 21, 0.3) 45%, transparent 100%);
    clip-path: polygon(100% 40%, 0% 0%, 0% 100%, 100% 60%);
    pointer-events: none;
    animation: coneSweeping 3.5s infinite ease-in-out alternate;
    filter: drop-shadow(0 0 8px rgba(254, 240, 138, 0.4));
  }

  .flashlight-super-spotlight .volumetric-light-cone {
    background: linear-gradient(270deg, rgba(255, 255, 255, 0.98) 0%, rgba(254, 240, 138, 0.8) 60%, transparent 100%);
    width: 210px;
    height: 110px;
    top: 18px;
  }

  /* 3D Patrol Mascot Animation */
  .uncle-character-box-3d {
    position: relative;
    z-index: 2;
    animation: unclePatrolLoop 7s infinite cubic-bezier(0.45, 0.05, 0.55, 0.95);
  }

  .cat-mascot-img-3d {
    display: block;
    width: 90px;
    height: auto;
    filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.45));
    transition: transform 0.2s ease;
  }

  .jingle-keys {
    transform-origin: 78px 98px;
    animation: keyJingle 1.5s infinite ease-in-out alternate;
  }

  @keyframes keyJingle {
    0% { transform: rotate(-8deg); }
    100% { transform: rotate(12deg); }
  }

  @keyframes unclePatrolLoop {
    0% { transform: translateX(0px) scaleX(1); }
    45% { transform: translateX(45px) scaleX(1); }
    50% { transform: translateX(45px) scaleX(-1); }
    95% { transform: translateX(0px) scaleX(-1); }
    100% { transform: translateX(0px) scaleX(1); }
  }

  @keyframes coneSweeping {
    0% { opacity: 0.85; transform: rotate(-2deg); }
    50% { opacity: 0.6; transform: rotate(3deg) scaleY(0.9); }
    100% { opacity: 0.95; transform: rotate(-4deg); }
  }

  /* 3D Stage Platform Base Deck with Hazard Stripes */
  .stage-platform-base {
    width: 100px;
    height: 12px;
    background: #18181b;
    border: 2px solid #ffffff;
    box-shadow: 4px 4px 0px #000000;
    margin-top: -6px;
    position: relative;
    overflow: hidden;
  }

  .hazard-stripes {
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
      -45deg,
      #d92626,
      #d92626 8px,
      #18181b 8px,
      #18181b 16px
    );
    opacity: 0.9;
  }

  /* 3D Speech Bubble & Stamp Dialog */
  .uncle-speech-bubble {
    background: #121214;
    color: #ffffff;
    border: 2.5px solid #ffffff;
    box-shadow: 6px 6px 0px var(--accent-red);
    padding: 1rem 1.1rem;
    width: 300px;
    margin-bottom: 1rem;
    position: relative;
    border-radius: 6px;
    z-index: 10000;
    animation: popIn3D 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .uncle-speech-bubble.hidden {
    display: none;
  }

  .bubble-3d-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1.5px dashed #44444c;
    padding-bottom: 0.4rem;
    margin-bottom: 0.6rem;
  }

  .header-tag {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .status-dot-green {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 6px #22c55e;
  }

  .role-title {
    color: var(--accent-red);
    font-weight: 900;
    font-size: 0.85rem;
  }

  .bubble-close {
    background: none;
    border: none;
    color: #aaaaaa;
    font-size: 1.3rem;
    font-weight: 900;
    cursor: pointer;
    line-height: 1;
  }

  .bubble-close:hover {
    color: #ffffff;
  }

  .speech-text {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #f4f4f5;
  }

  .dialog-stamp-seal {
    display: inline-block;
    border: 2px double var(--accent-red);
    color: var(--accent-red);
    font-size: 0.72rem;
    font-weight: 900;
    padding: 0.15rem 0.5rem;
    margin-top: 0.6rem;
    transform: rotate(-4deg);
    background: rgba(217, 38, 38, 0.08);
  }

  .bubble-arrow-3d {
    position: absolute;
    bottom: -12px;
    left: 36px;
    width: 0;
    height: 0;
    border-left: 10px solid transparent;
    border-right: 10px solid transparent;
    border-top: 12px solid #121214;
  }

  @keyframes popIn3D {
    from { opacity: 0; transform: translateY(12px) scale(0.9); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* Responsive Mobile Layout */
  @media (max-width: 600px) {
    .patrol-uncle-container {
      bottom: 16px;
      left: 16px;
    }
    .uncle-speech-bubble {
      width: 240px;
      padding: 0.8rem;
    }
    .speech-text {
      font-size: 0.82rem;
    }
    .uncle-svg-3d {
      width: 70px;
      height: 82px;
    }
    .stage-platform-base {
      width: 80px;
    }
  }
</style>
