---

<!-- 3D 宿管猫：点击互动，双击开关手电，沿右下角巡逻 -->
<div id="patrol-cat" class="patrol-cat" role="button" tabindex="0" aria-label="宿管猫巡逻中，点击互动；双击切换手电">
  <div class="cat-speech" id="cat-speech" role="status" aria-live="polite">
    <span class="cat-speech__title">宿管猫巡逻中</span>
    <span id="cat-speech-text">喵～点击我领取本周巡查报告！</span>
  </div>
  <span class="cat-stamp" id="cat-stamp" aria-hidden="true">合格</span>
  <span class="cat-light" id="cat-light" aria-hidden="true"></span>
  <img src="/images/patrol-cat-3d-cutout.png" alt="手持钥匙和手电的 3D 宿管橘猫" draggable="false" />
</div>

<script>
  (() => {
    const cat = document.querySelector('#patrol-cat') as HTMLElement | null;
    const speech = document.querySelector('#cat-speech') as HTMLElement | null;
    const speechText = document.querySelector('#cat-speech-text') as HTMLElement | null;
    const stamp = document.querySelector('#cat-stamp') as HTMLElement | null;
    if (!cat || !speech || !speechText || !stamp) return;
    const sayings = ['喵～巡逻正常，网络也要正常！', '🔑 叮当～钥匙串响，查房开始。', '🚨 延迟太高？让我拿手电照照。', '🐾 防坑手册已备好，月付更安心！', '😼 宿管猫盖章：本周全线合格！', '喵！发现摸鱼行为，请立即恢复连接。'];
    let active = false, lightOn = false, last = -1;
    let hideTimer: ReturnType<typeof setTimeout> | undefined;
    const say = (message?: string) => {
      let index = last;
      if (!message) { while (index === last) index = Math.floor(Math.random() * sayings.length); last = index; }
      speechText.textContent = message ?? sayings[index];
      active = true; cat.classList.add('is-active'); stamp.classList.add('is-stamping');
      window.clearTimeout(hideTimer);
      hideTimer = window.setTimeout(() => { active = false; cat.classList.remove('is-active'); }, 3600);
      window.setTimeout(() => stamp.classList.remove('is-stamping'), 850);
    };
    const toggleLight = () => { lightOn = !lightOn; cat.classList.toggle('is-light-on', lightOn); say(lightOn ? '🔦 手电已打开，巡查视野拉满！' : '🔦 手电收好，继续安静巡逻。'); };
    cat.addEventListener('click', () => say());
    cat.addEventListener('dblclick', (event) => { event.preventDefault(); toggleLight(); });
    cat.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); say(); }
      if (event.key.toLowerCase() === 'l') toggleLight();
    });
    window.setTimeout(() => say('喵～宿管猫已到岗，点击我互动！'), 1800);
    window.setInterval(() => { if (!active) say(); }, 26000);
  })();
</script>

<style>
  .patrol-cat { --patrol-distance: 112px; position: fixed; right: 18px; bottom: 10px; z-index: 9999; width: clamp(168px, 17vw, 228px); cursor: pointer; user-select: none; outline: none; animation: patrol 13s ease-in-out infinite alternate; filter: drop-shadow(0 9px 12px rgba(42,20,6,.24)); }
  .patrol-cat img { display: block; width: 100%; height: auto; animation: cat-bob .72s ease-in-out infinite alternate; transition: transform .22s ease, filter .22s ease; }
  .patrol-cat:hover img, .patrol-cat:focus-visible img, .patrol-cat.is-active img { transform: scale(1.09) rotate(-2deg); filter: saturate(1.08); }
  .patrol-cat:focus-visible { outline: 3px solid #e32125; outline-offset: 4px; border-radius: 20px; }
  .cat-speech { position: absolute; right: -8px; bottom: calc(100% + 8px); width: max-content; max-width: min(250px, calc(100vw - 28px)); padding: .6rem .75rem; border: 2px solid #f23b35; border-radius: 15px 15px 4px 15px; background: #171719; box-shadow: 4px 4px 0 #f23b35; color: #fff8e9; font-size: .8rem; font-weight: 700; line-height: 1.45; opacity: 0; transform: translateY(9px) scale(.92); pointer-events: none; transition: opacity .2s ease, transform .2s ease; }
  .cat-speech::after { content: ''; position: absolute; right: 24px; bottom: -9px; border: 9px solid transparent; border-top-color: #171719; border-bottom: 0; }
  .cat-speech__title { display: block; margin-bottom: .18rem; color: #ff6960; font-size: .67rem; letter-spacing: .08em; }
  .patrol-cat.is-active .cat-speech, .patrol-cat:hover .cat-speech, .patrol-cat:focus-visible .cat-speech { opacity: 1; transform: none; }
  .cat-stamp { position: absolute; left: -8px; top: 35%; z-index: 2; width: 54px; height: 54px; display: grid; place-items: center; border: 3px solid #e32125; border-radius: 50%; color: #e32125; background: rgba(255,255,255,.8); font-size: .91rem; font-weight: 900; opacity: 0; transform: rotate(-18deg) scale(1.8); pointer-events: none; }
  .cat-stamp.is-stamping { animation: stamp .8s ease-out both; }
  .cat-light { position: absolute; left: -58%; bottom: 12%; width: 76%; height: 31%; background: linear-gradient(90deg, rgba(255,238,95,.5), rgba(255,238,95,0)); clip-path: polygon(100% 28%,0 0,0 100%,100% 72%); opacity: 0; transform-origin: right center; pointer-events: none; transition: opacity .2s ease; }
  .patrol-cat.is-light-on .cat-light { opacity: 1; animation: torch 1.4s ease-in-out infinite alternate; }
  @keyframes patrol { from { transform: translateX(0); } 48% { transform: translateX(calc(-1 * var(--patrol-distance))); } 52% { transform: translateX(calc(-1 * var(--patrol-distance))); } to { transform: translateX(0); } }
  @keyframes cat-bob { from { translate: 0 0; } to { translate: 0 -3px; } }
  @keyframes stamp { 0% { opacity: 0; transform: rotate(-18deg) scale(1.8); } 42% { opacity: 1; transform: rotate(-18deg) scale(.92); } 100% { opacity: 0; transform: rotate(-18deg) scale(1); } }
  @keyframes torch { from { opacity: .54; } to { opacity: .92; } }
  @media (max-width: 600px) { .patrol-cat { --patrol-distance: 48px; right: 7px; bottom: 4px; width: 132px; } .cat-speech { right: -4px; max-width: min(230px, calc(100vw - 20px)); font-size: .74rem; } }
  @media (prefers-reduced-motion: reduce) { .patrol-cat, .patrol-cat img, .cat-stamp.is-stamping, .patrol-cat.is-light-on .cat-light { animation: none; } }
</style>
