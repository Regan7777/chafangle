<div id="patrol-uncle-widget" class="patrol-uncle-container" role="button" tabindex="0" aria-label="宿管大爷 3D 可拖拽返回顶点按键">
  <!-- 3D Speech Bubble & Stamp Dialog -->
  <div id="uncle-dialog" class="uncle-speech-bubble hidden font-mono">
    <div class="bubble-3d-header">
      <div class="header-tag">
        <span class="status-dot-green"></span>
        <span class="role-title">【宿管直达电梯】</span>
      </div>
      <button id="close-dialog-btn" class="bubble-close" aria-label="关闭">&times;</button>
    </div>

    <!-- Speech Text Body -->
    <div id="uncle-speech-text" class="speech-text">
      🚀 宿管大爷已搭乘直达电梯把您送回顶楼！白天全绿不算数，全周7×24小时扛得住才算数！
    </div>

    <!-- Dynamic 3D Stamp Seal Effect -->
    <div class="dialog-stamp-seal">
      顶楼巡查归位印
    </div>

    <div class="bubble-arrow-3d"></div>
  </div>

  <!-- 3D Patrol Stage Container -->
  <div class="patrol-stage-3d">
    <!-- Volumetric 3D Light Cone -->
    <div class="volumetric-light-cone"></div>

    <!-- Floating 3D Badge -->
    <div class="stage-badge-3d">
      <span class="pulse-red-light"></span> 周巡查中 · ⬆ 点击回顶
    </div>

    <!-- 3D Uncle Vector Character with Depth Shading -->
    <div class="uncle-character-box-3d">
      <svg class="uncle-svg-3d" viewBox="0 0 120 140" width="85" height="100" aria-hidden="true">
        <defs>
          <!-- 3D Shading Gradients -->
          <radialGradient id="flashlightGlow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
            <stop offset="40%" stop-color="#fef08a" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#facc15" stop-opacity="0" />
          </radialGradient>
          
          <linearGradient id="body3D" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#27272a" />
            <stop offset="50%" stop-color="#18181b" />
            <stop offset="100%" stop-color="#09090b" />
          </linearGradient>

          <linearGradient id="hat3D" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#3f3f46" />
            <stop offset="70%" stop-color="#18181b" />
            <stop offset="100%" stop-color="#000000" />
          </linearGradient>

          <linearGradient id="belt3D" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#b91c1c" />
            <stop offset="50%" stop-color="#ef4444" />
            <stop offset="100%" stop-color="#991b1b" />
          </linearGradient>
          
          <linearGradient id="metalKey" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#fef08a" />
            <stop offset="50%" stop-color="#eab308" />
            <stop offset="100%" stop-color="#854d0e" />
          </linearGradient>

          <filter id="shadow3D" x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="3" dy="4" stdDeviation="2" flood-color="#000000" flood-opacity="0.6"/>
          </filter>
        </defs>

        <!-- 3D Platform Ground Shadow -->
        <ellipse cx="60" cy="132" rx="42" ry="7" fill="rgba(0,0,0,0.45)" filter="blur(1px)"/>

        <!-- Heavy Inspector Boots (防滑大皮靴) -->
        <g class="uncle-boots">
          <!-- Left Boot -->
          <path d="M 38 112 L 48 112 L 50 126 L 34 126 Z" fill="#09090b" stroke="#ffffff" stroke-width="1.5" />
          <!-- Right Boot -->
          <path d="M 68 112 L 78 112 L 84 126 L 66 126 Z" fill="#09090b" stroke="#ffffff" stroke-width="1.5" />
        </g>

        <!-- Overalls Body with 3D Depth & Straps -->
        <rect x="36" y="62" width="46" height="52" rx="6" fill="url(#body3D)" stroke="#ffffff" stroke-width="2.5" filter="url(#shadow3D)" />
        
        <!-- Chest Pocket & Badge -->
        <rect x="42" y="70" width="14" height="14" rx="2" fill="#18181b" stroke="#52525b" stroke-width="1.5" />
        <rect x="44" y="72" width="10" height="4" fill="#d92626" />
        <text x="49" y="82" font-size="6" fill="#ffffff" font-weight="900" text-anchor="middle">宿管</text>

        <!-- 3D Red Inspector Belt -->
        <rect x="34" y="90" width="50" height="9" fill="url(#belt3D)" stroke="#ffffff" stroke-width="1.5" />
        <!-- Belt Buckle -->
        <rect x="53" y="88" width="12" height="13" rx="2" fill="#facc15" stroke="#111111" stroke-width="1.5" />
        <rect x="56" y="91" width="6" height="7" fill="#854d0e" />

        <!-- 3D Jingling Key Ring (金属钥匙串) -->
        <g class="jingle-keys">
          <circle cx="78" cy="98" r="6" fill="none" stroke="url(#metalKey)" stroke-width="2.5" />
          <path d="M 78 104 L 78 122 M 74 104 L 71 118 M 82 104 L 86 120" stroke="url(#metalKey)" stroke-width="2" stroke-linecap="round" />
          <circle cx="78" cy="122" r="1.5" fill="#facc15" />
        </g>

        <!-- Head & Face -->
        <rect x="42" y="28" width="34" height="36" rx="8" fill="#fed7aa" stroke="#18181b" stroke-width="2.5" />
        <!-- Ears -->
        <circle cx="39" cy="46" r="4" fill="#fdba74" stroke="#18181b" stroke-width="1.5" />
        <circle cx="79" cy="46" r="4" fill="#fdba74" stroke="#18181b" stroke-width="1.5" />

        <!-- Glasses & Eyes -->
        <circle cx="51" cy="44" r="5" fill="rgba(255,255,255,0.3)" stroke="#111" stroke-width="2" />
        <circle cx="67" cy="44" r="5" fill="rgba(255,255,255,0.3)" stroke="#111" stroke-width="2" />
        <line x1="56" y1="44" x2="62" y2="44" stroke="#111" stroke-width="2" />
        <circle cx="52" cy="44" r="1.5" fill="#111" />
        <circle cx="68" cy="44" r="1.5" fill="#111" />

        <!-- Mustache (胡须) -->
        <path d="M 48 53 Q 59 58 70 53" stroke="#27272a" stroke-width="3.5" fill="none" stroke-linecap="round" />

        <!-- 3D Dorm Inspector Cap (宿管大檐帽) -->
        <path d="M 32 30 Q 59 10 86 30 L 92 35 L 26 35 Z" fill="url(#hat3D)" stroke="#ffffff" stroke-width="2" filter="url(#shadow3D)" />
        <rect x="26" y="32" width="66" height="5" rx="2" fill="#d92626" />
        <!-- Gold Cap Emblem (帽徽) -->
        <polygon points="59,18 63,26 55,26" fill="#facc15" stroke="#111111" stroke-width="1" />

        <!-- 3D Tactical Flashlight Arm (手电筒抓包臂) -->
        <g class="flashlight-arm-3d">
          <path d="M 38 68 L 18 78 L 8 72" stroke="#27272a" stroke-width="9" stroke-linecap="round" fill="none" />
          <!-- Heavy Duty Flashlight Casing -->
          <rect x="-4" y="64" width="22" height="13" rx="2" fill="#3f3f46" stroke="#ffffff" stroke-width="2" />
          <rect x="-10" y="60" width="8" height="21" rx="2" fill="#facc15" stroke="#111111" stroke-width="2" />
          <!-- Flashlight Lens Glow -->
          <ellipse cx="-10" cy="70.5" rx="2" ry="8" fill="url(#flashlightGlow)" />
        </g>
      </svg>
    </div>

    <!-- 3D Stage Platform Base Deck with Hazard Stripes -->
    <div class="stage-platform-base">
      <div class="hazard-stripes"></div>
    </div>
  </div>
</div>

<script>
  // Richer, Immersive Chinese Weekly Dorm Patrol Quotes
  const uncleQuotes = [
    "🚀【宿管速报】搭乘直达电梯成功返回楼顶！802寝室本周测试丢包率正常，继续巡楼！",
    "🔦【咔哒·强光开启】已直达顶楼！白天全绿不算数，全周 7×24 小时扛得住才算数！",
    "🔑【钥匙串叮当响】手电筒与测速仪准备就绪！一键送您回顶楼，随时查看最新卷宗！",
    "🔋【电量满格】周巡查电梯提速升空！周巡查模式开启，谁也别想开小差！",
    "🚨【通报拉闸】走廊里不许大声喧哗！已被宿管搭乘电梯送回最上方视察！",
    "🏆【免检通报】已送达顶楼导航处！模范寝室全周 SLA 连通率稳定 99.98%！",
    "📢【巡楼喊话】宿管大爷随时待命！拖拽可更换位置，点击即刻直达楼顶！"
  ];

  const widget = document.getElementById('patrol-uncle-widget');
  const dialog = document.getElementById('uncle-dialog');
  const speechText = document.getElementById('uncle-speech-text');
  const closeBtn = document.getElementById('close-dialog-btn');

  let lastIndex = -1;
  let isDragging = false;
  let startX = 0, startY = 0;
  let initialLeft = 24, initialBottom = 24;
  let currentLeft = 24, currentBottom = 24;
  let hasMoved = false;

  function getRandomQuote() {
    let nextIndex;
    do {
      nextIndex = Math.floor(Math.random() * uncleQuotes.length);
    } while (nextIndex === lastIndex && uncleQuotes.length > 1);
    lastIndex = nextIndex;
    return uncleQuotes[nextIndex];
  }

  function triggerUncleResponse() {
    // 1. Scroll to top smooth
    window.scrollTo({ top: 0, behavior: 'smooth' });

    // 2. Speech bubble dialog response
    if (!dialog || !speechText) return;
    speechText.textContent = getRandomQuote();
    dialog.classList.remove('hidden');

    // 3. Flashlight Spotlight animation
    widget?.classList.add('flashlight-super-spotlight');
    setTimeout(() => {
      widget?.classList.remove('flashlight-super-spotlight');
    }, 600);
  }

  // --- DRAGGABLE & CLICK HANDLING ---
  if (widget) {
    // Pointer / Mouse Down
    const onStart = (e: MouseEvent | TouchEvent) => {
      if ((e.target as HTMLElement).closest('#close-dialog-btn')) return;

      isDragging = true;
      hasMoved = false;
      const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
      const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;

      startX = clientX;
      startY = clientY;

      const rect = widget.getBoundingClientRect();
      // Calculate current position relative to viewport
      initialLeft = rect.left;
      initialBottom = window.innerHeight - rect.bottom;

      widget.style.transition = 'none';
    };

    const onMove = (e: MouseEvent | TouchEvent) => {
      if (!isDragging) return;

      const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
      const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;

      const deltaX = clientX - startX;
      const deltaY = clientY - startY;

      if (Math.abs(deltaX) > 4 || Math.abs(deltaY) > 4) {
        hasMoved = true;
      }

      if (hasMoved) {
        let newLeft = initialLeft + deltaX;
        let newBottom = initialBottom - deltaY;

        // Boundary restriction
        const maxLeft = window.innerWidth - widget.offsetWidth - 10;
        const maxBottom = window.innerHeight - widget.offsetHeight - 10;

        newLeft = Math.max(10, Math.min(newLeft, maxLeft));
        newBottom = Math.max(10, Math.min(newBottom, maxBottom));

        widget.style.left = `${newLeft}px`;
        widget.style.bottom = `${newBottom}px`;
        widget.style.top = 'auto';
        widget.style.right = 'auto';
      }
    };

    const onEnd = () => {
      if (!isDragging) return;
      isDragging = false;
      widget.style.transition = 'transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1)';

      if (!hasMoved) {
        // Pure click tap (not drag) -> trigger Back To Top & Response
        triggerUncleResponse();
      }
    };

    // Event Listeners
    widget.addEventListener('mousedown', onStart);
    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup', onEnd);

    widget.addEventListener('touchstart', onStart, { passive: true });
    document.addEventListener('touchmove', onMove, { passive: true });
    document.addEventListener('touchend', onEnd);

    // Keyboard accessibility
    widget.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        triggerUncleResponse();
      }
    });
  }

  if (closeBtn) {
    closeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      dialog?.classList.add('hidden');
    });
  }
</script>

<style>
  .patrol-uncle-container {
    position: fixed;
    bottom: 24px;
    left: 24px;
    z-index: 9999;
    cursor: grab;
    user-select: none;
    touch-action: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    perspective: 800px;
  }

  .patrol-uncle-container:active {
    cursor: grabbing;
  }

  /* 3D Stage Platform Wrapper */
  .patrol-stage-3d {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform-style: preserve-3d;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .patrol-uncle-container:hover .patrol-stage-3d {
    transform: translateY(-6px) rotateX(6deg) scale(1.06);
  }

  /* 3D Floating Badge */
  .stage-badge-3d {
    position: absolute;
    top: -24px;
    background: #18181b;
    color: #ffffff;
    border: 1.5px solid var(--accent-red);
    box-shadow: 2px 2px 0px #000000;
    padding: 0.15rem 0.5rem;
    font-size: 0.72rem;
    font-weight: 900;
    font-family: var(--font-mono);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
    z-index: 10;
  }

  .pulse-red-light {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-red);
    box-shadow: 0 0 6px var(--accent-red);
    animation: pulseGlow 1.2s infinite ease-in-out;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.3; transform: scale(0.7); }
  }

  /* Volumetric 3D Light Cone Beam */
  .volumetric-light-cone {
    position: absolute;
    left: -140px;
    top: 28px;
    width: 155px;
    height: 90px;
    background: linear-gradient(270deg, rgba(254, 240, 138, 0.75) 0%, rgba(250, 204, 21, 0.3) 45%, transparent 100%);
    clip-path: polygon(100% 40%, 0% 0%, 0% 100%, 100% 60%);
    pointer-events: none;
    animation: coneSweeping 3.5s infinite ease-in-out alternate;
    filter: drop-shadow(0 0 8px rgba(254, 240, 138, 0.4));
  }

  .flashlight-super-spotlight .volumetric-light-cone {
    background: linear-gradient(270deg, rgba(255, 255, 255, 0.98) 0%, rgba(254, 240, 138, 0.8) 60%, transparent 100%);
    width: 210px;
    height: 110px;
    top: 18px;
  }

  /* 3D Patrol Uncle Animation */
  .uncle-character-box-3d {
    position: relative;
    z-index: 2;
    animation: unclePatrolLoop 7s infinite cubic-bezier(0.45, 0.05, 0.55, 0.95);
  }

  .jingle-keys {
    transform-origin: 78px 98px;
    animation: keyJingle 1.5s infinite ease-in-out alternate;
  }

  @keyframes keyJingle {
    0% { transform: rotate(-8deg); }
    100% { transform: rotate(12deg); }
  }

  @keyframes unclePatrolLoop {
    0% { transform: translateX(0px) scaleX(1); }
    45% { transform: translateX(45px) scaleX(1); }
    50% { transform: translateX(45px) scaleX(-1); }
    95% { transform: translateX(0px) scaleX(-1); }
    100% { transform: translateX(0px) scaleX(1); }
  }

  @keyframes coneSweeping {
    0% { opacity: 0.85; transform: rotate(-2deg); }
    50% { opacity: 0.6; transform: rotate(3deg) scaleY(0.9); }
    100% { opacity: 0.95; transform: rotate(-4deg); }
  }

  /* 3D Stage Platform Base Deck with Hazard Stripes */
  .stage-platform-base {
    width: 100px;
    height: 12px;
    background: #18181b;
    border: 2px solid #ffffff;
    box-shadow: 4px 4px 0px #000000;
    margin-top: -6px;
    position: relative;
    overflow: hidden;
  }

  .hazard-stripes {
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
      -45deg,
      #d92626,
      #d92626 8px,
      #18181b 8px,
      #18181b 16px
    );
    opacity: 0.9;
  }

  /* 3D Speech Bubble & Stamp Dialog */
  .uncle-speech-bubble {
    background: #121214;
    color: #ffffff;
    border: 2.5px solid #ffffff;
    box-shadow: 6px 6px 0px var(--accent-red);
    padding: 1rem 1.1rem;
    width: 300px;
    margin-bottom: 1rem;
    position: relative;
    border-radius: 6px;
    z-index: 10000;
    animation: popIn3D 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .uncle-speech-bubble.hidden {
    display: none;
  }

  .bubble-3d-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1.5px dashed #44444c;
    padding-bottom: 0.4rem;
    margin-bottom: 0.6rem;
  }

  .header-tag {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .status-dot-green {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 6px #22c55e;
  }

  .role-title {
    color: var(--accent-red);
    font-weight: 900;
    font-size: 0.85rem;
  }

  .bubble-close {
    background: none;
    border: none;
    color: #aaaaaa;
    font-size: 1.3rem;
    font-weight: 900;
    cursor: pointer;
    line-height: 1;
  }

  .bubble-close:hover {
    color: #ffffff;
  }

  .speech-text {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #f4f4f5;
  }

  .dialog-stamp-seal {
    display: inline-block;
    border: 2px double var(--accent-red);
    color: var(--accent-red);
    font-size: 0.72rem;
    font-weight: 900;
    padding: 0.15rem 0.5rem;
    margin-top: 0.6rem;
    transform: rotate(-4deg);
    background: rgba(217, 38, 38, 0.08);
  }

  .bubble-arrow-3d {
    position: absolute;
    bottom: -12px;
    left: 36px;
    width: 0;
    height: 0;
    border-left: 10px solid transparent;
    border-right: 10px solid transparent;
    border-top: 12px solid #121214;
  }

  @keyframes popIn3D {
    from { opacity: 0; transform: translateY(12px) scale(0.9); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* Responsive Mobile Layout */
  @media (max-width: 600px) {
    .patrol-uncle-container {
      bottom: 16px;
      left: 16px;
    }
    .uncle-speech-bubble {
      width: 240px;
      padding: 0.8rem;
    }
    .speech-text {
      font-size: 0.82rem;
    }
    .uncle-svg-3d {
      width: 70px;
      height: 82px;
    }
    .stage-platform-base {
      width: 80px;
    }
  }
</style>
