<style>
  .site-footer {
    background: var(--bg-dark);
    color: #e5e5e5;
    border-top: 4px solid var(--border-thick);
    margin-top: auto;
    padding: 3rem 0 2rem 0;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .footer-brand {
    border-bottom: 1.5px dashed #444;
    padding-bottom: 1.5rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1rem;
  }

  .logo-box {
    background: var(--accent-red);
    color: #ffffff;
    font-weight: 900;
    font-size: 1.3rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid #ffffff;
  }

  .logo-sub {
    font-size: 0.95rem;
    color: #bbbbbb;
    font-weight: 700;
  }

  .footer-disclaimer {
    font-size: 0.9rem;
    color: #aaaaaa;
    line-height: 1.6;
    max-width: 850px;
    background: #1e1e24;
    padding: 0.8rem 1.2rem;
    border-left: 3px solid var(--accent-red);
  }

  .footer-disclaimer strong {
    color: #ffffff;
  }

  .footer-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
  }

  .link-group h3 {
    color: #ffffff;
    font-size: 1.1rem;
    margin-top: 0;
    margin-bottom: 1rem;
    border-bottom: 1px solid #444;
    padding-bottom: 0.4rem;
  }

  .link-group ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .link-group li {
    margin-bottom: 0.5rem;
  }

  .link-group a {
    color: #cccccc;
    font-size: 0.9rem;
  }

  .link-group a:hover {
    color: var(--accent-red);
  }

  .tg-footer-list a {
    color: #facc15;
    font-weight: 700;
    text-decoration: underline;
  }

  .tg-footer-list a:hover {
    color: #ffffff;
  }

  .footer-bottom {
    border-top: 1.5px solid #333338;
    padding-top: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    color: #888888;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .inspection-seal {
    font-family: var(--font-mono);
    color: var(--accent-red);
    border: 1px solid var(--accent-red);
    padding: 0.2rem 0.5rem;
  }

  @media (max-width: 600px) {
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
