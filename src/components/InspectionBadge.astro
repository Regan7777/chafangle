---
export type VerdictType = 'five-star' | 'warning' | 'confiscated' | 'ghost';

interface Props {
  verdict: VerdictType;
  customNote?: string;
}

const { verdict, customNote } = Astro.props;

const verdictData = {
  'five-star': {
    title: '🏆 五星推荐（强烈推荐）',
    badgeText: '五星推荐',
    badgeClass: 'badge-gold',
    desc: '全周巡查周期内播放、加载与连接表现稳定，低丢包。',
    borderClass: 'border-gold',
    bgClass: 'bg-gold-tint'
  },
  'warning': {
    title: '⚠️ 谨慎观察（偶有波动）',
    badgeText: '谨慎观察',
    badgeClass: 'badge-amber',
    desc: '平峰表现良好，周巡查期间偶有波动，建议谨慎观察。',
    borderClass: 'border-amber',
    bgClass: 'bg-amber-tint'
  },
  'confiscated': {
    title: '🚨 性能较差（拉闸避坑）',
    badgeText: '直接拉闸',
    badgeClass: 'badge-red',
    desc: '周巡查周期内延迟明显升高、稳定性差或售后响应不佳。',
    borderClass: 'border-red',
    bgClass: 'bg-red-tint'
  },
  'ghost': {
    title: '👻 跑路失联（已提桶跑路）',
    badgeText: '已提桶',
    badgeClass: 'badge-gray',
    desc: '服务域名、公告或支持渠道长期无法访问。',
    borderClass: 'border-gray',
    bgClass: 'bg-gray-tint'
  }
};

const current = verdictData[verdict] || verdictData['warning'];
---

<div class={`inspection-conclusion-card ${current.borderClass} ${current.bgClass}`}>
  <div class="card-header">
    <span class="header-tag">宿管周巡查结论</span>
    <span class={`status-pill ${current.badgeClass}`}>{current.badgeText}</span>
  </div>
  
  <h4 class="verdict-title">{current.title}</h4>
  
  <p class="verdict-desc">
    {current.desc}
  </p>

  {customNote && (
    <div class="custom-note">
      <strong>宿管附言：</strong>{customNote}
    </div>
  )}

  <div class="disclaimer-mini">
    * 注：本评测结论基于宿管周度例行抽查实测，网络环境随时变动，不构成直接购买投资建议。
  </div>
</div>

<style>
  .inspection-conclusion-card {
    border: 3px solid var(--border-thick);
    box-shadow: 5px 5px 0px var(--border-thick);
    padding: 1.5rem;
    margin: 2rem 0;
    position: relative;
    background: #ffffff;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px dashed var(--border-thick);
    padding-bottom: 0.6rem;
    margin-bottom: 1rem;
  }

  .header-tag {
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-muted);
  }

  .status-pill {
    font-family: var(--font-mono);
    font-weight: 900;
    font-size: 0.85rem;
    padding: 0.2rem 0.6rem;
    border: 1.5px solid var(--border-thick);
  }

  .badge-gold { background: #fbbf24; color: #111; }
  .badge-amber { background: #f59e0b; color: #111; }
  .badge-red { background: #dc2626; color: #ffffff; }
  .badge-gray { background: #4b5563; color: #ffffff; }

  .verdict-title {
    font-size: 1.4rem;
    font-weight: 900;
    margin: 0.5rem 0;
  }

  .verdict-desc {
    font-size: 1rem;
    font-weight: 600;
    color: #222;
    margin-bottom: 1rem;
  }

  .border-gold { border-color: #d97706; }
  .bg-gold-tint { background: #fffdf5; }

  .border-amber { border-color: #b45309; }
  .bg-amber-tint { background: #fffbeb; }

  .border-red { border-color: var(--accent-red); }
  .bg-red-tint { background: #fff5f5; }

  .border-gray { border-color: #374151; }
  .bg-gray-tint { background: #f3f4f6; }

  .custom-note {
    background: rgba(0, 0, 0, 0.04);
    border-left: 3px solid var(--border-thick);
    padding: 0.6rem 0.9rem;
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }

  .disclaimer-mini {
    font-size: 0.8rem;
    color: #666666;
    font-style: italic;
  }
</style>
