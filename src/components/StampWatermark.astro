---
interface Props {
  text?: string;
  subText?: string;
  size?: 'sm' | 'md' | 'lg';
}

const {
  text = '查房了·突击取证专用章',
  subText = '周巡查检验合格',
  size = 'md'
} = Astro.props;
---

<div class={`stamp-watermark-wrapper stamp-size-${size}`} role="button" tabindex="0" title="点击偷盖宿管大爷印章！">
  <div class="stamp-outer-ring">
    <div class="stamp-inner-ring">
      <div class="stamp-star">★</div>
      <div class="stamp-main-text" data-original-text={text}>{text}</div>
      <div class="stamp-sub-text" data-original-subtext={subText}>{subText}</div>
    </div>
  </div>
  <div class="stamp-funny-tooltip font-mono">👉 点击盖章！</div>
</div>

<script>
  // Funny quotes on stamp slam
  const funnyStampPops = [
    "💥 啪！盖章成功！准了！",
    "📜 宿管大爷亲笔批复：绝无断流！",
    "🚨 突击抓包验证：此贴保真！",
    "🈲 偷偷盖个霸王章~ 别告诉别人！",
    "✨ 获得【五星推荐】BUFF加持！",
    "💮 啪啪啪！多印两下才踏实！",
    "🔑 印章已生效！钥匙串拿好！",
    "🎉 盖章成功！此封印不可逆转！"
  ];

  const funnyMainTexts = [
    "【啪！一盖定音】",
    "【宿管特批·五星章】",
    "【偷盖成功·暗号007】",
    "【保质期：100年】",
    "【官方认证·绝无虚标】"
  ];

  document.querySelectorAll('.stamp-watermark-wrapper').forEach((wrapper) => {
    let isStamping = false;

    const mainTextEl = wrapper.querySelector('.stamp-main-text') as HTMLElement;
    const subTextEl = wrapper.querySelector('.stamp-sub-text') as HTMLElement;
    const origMainText = mainTextEl?.dataset.originalText || mainTextEl?.textContent || '';
    const origSubText = subTextEl?.dataset.originalSubtext || subTextEl?.textContent || '';

    wrapper.addEventListener('click', (e) => {
      if (isStamping) return;
      isStamping = true;

      // Slam animation effect
      wrapper.classList.add('is-slammed');

      // Random funny text replace temporarily
      if (mainTextEl) {
        const randomMain = funnyMainTexts[Math.floor(Math.random() * funnyMainTexts.length)];
        mainTextEl.textContent = randomMain;
      }
      if (subTextEl) {
        subTextEl.textContent = "⚡ 宿管大爷印章气场全开！";
      }

      // Create Floating Funny Toast Pop
      const rect = wrapper.getBoundingClientRect();
      const toast = document.createElement('div');
      toast.className = 'stamp-funny-toast font-mono';
      toast.textContent = funnyStampPops[Math.floor(Math.random() * funnyStampPops.length)];
      
      // Position pop near stamp
      toast.style.left = `${(e as MouseEvent).clientX || (rect.left + rect.width / 2)}px`;
      toast.style.top = `${((e as MouseEvent).clientY || rect.top) - 20}px`;
      document.body.appendChild(toast);

      // Create Red Ink Splatter Particles
      for (let i = 0; i < 8; i++) {
        const particle = document.createElement('div');
        particle.className = 'stamp-ink-particle';
        const angle = (i / 8) * 360;
        const dist = 35 + Math.random() * 25;
        const tx = Math.cos(angle * Math.PI / 180) * dist;
        const ty = Math.sin(angle * Math.PI / 180) * dist;
        particle.style.setProperty('--tx', `${tx}px`);
        particle.style.setProperty('--ty', `${ty}px`);
        particle.style.left = `${rect.left + rect.width / 2}px`;
        particle.style.top = `${rect.top + rect.height / 2}px`;
        document.body.appendChild(particle);

        setTimeout(() => particle.remove(), 600);
      }

      // Remove toast after animation
      setTimeout(() => {
        toast.remove();
      }, 1500);

      // Reset stamp after 1.6s
      setTimeout(() => {
        wrapper.classList.remove('is-slammed');
        if (mainTextEl) mainTextEl.textContent = origMainText;
        if (subTextEl) subTextEl.textContent = origSubText;
        isStamping = false;
      }, 1600);
    });

    wrapper.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
        e.preventDefault();
        (wrapper as HTMLElement).click();
      }
    });
  });
</script>

<style>
  .stamp-watermark-wrapper {
    display: inline-block;
    user-select: none;
    pointer-events: auto;
    cursor: pointer;
    transform: rotate(-7deg);
    opacity: 0.92;
    margin: 1rem 0;
    position: relative;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.2s ease;
  }

  .stamp-watermark-wrapper:hover {
    transform: rotate(-3deg) scale(1.08);
    filter: drop-shadow(0 0 10px rgba(217, 38, 38, 0.5));
    animation: stampWobble 0.4s ease-in-out infinite alternate;
  }

  .stamp-watermark-wrapper:active,
  .stamp-watermark-wrapper.is-slammed {
    animation: stampSlam 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) strokeInk 0.3s;
    transform: rotate(-12deg) scale(1.22);
    filter: drop-shadow(0 0 18px rgba(217, 38, 38, 0.85));
  }

  /* Funny Tooltip */
  .stamp-funny-tooltip {
    position: absolute;
    bottom: -22px;
    left: 50%;
    transform: translateX(-50%);
    background: #18181b;
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 800;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--accent-red);
    box-shadow: 2px 2px 0px #000000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    white-space: nowrap;
    z-index: 10;
  }

  .stamp-watermark-wrapper:hover .stamp-funny-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(2px);
  }

  .stamp-outer-ring {
    border: 3px double var(--accent-red);
    padding: 4px;
    border-radius: 6px;
    background: rgba(217, 38, 38, 0.04);
    transition: all 0.2s ease;
  }

  .stamp-watermark-wrapper:hover .stamp-outer-ring {
    background: rgba(217, 38, 38, 0.12);
    border-color: #ef4444;
  }

  .stamp-inner-ring {
    border: 1.5px dashed var(--accent-red);
    padding: 0.6rem 1.2rem;
    text-align: center;
    color: var(--accent-red);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }

  .stamp-star {
    font-size: 1rem;
    line-height: 1;
    transition: transform 0.3s ease;
  }

  .stamp-watermark-wrapper:hover .stamp-star {
    transform: scale(1.4) rotate(360deg);
  }

  .stamp-main-text {
    font-weight: 900;
    font-size: 1.05rem;
    letter-spacing: 2px;
    font-family: var(--font-sans);
  }

  .stamp-sub-text {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .stamp-size-sm { transform: scale(0.85) rotate(-5deg); }
  .stamp-size-lg { transform: scale(1.1) rotate(-8deg); }

  @keyframes stampWobble {
    0% { transform: rotate(-5deg) scale(1.06); }
    100% { transform: rotate(-1deg) scale(1.1); }
  }

  @keyframes stampSlam {
    0% { transform: scale(0.8) rotate(-18deg); }
    50% { transform: scale(1.3) rotate(-3deg); }
    100% { transform: scale(1.22) rotate(-12deg); }
  }
</style>

<!-- Global Styles for Dynamic Ink Particles & Floating Funny Toasts -->
<style is:global>
  .stamp-funny-toast {
    position: fixed;
    z-index: 99999;
    background: #d92626;
    color: #ffffff;
    border: 2px solid #ffffff;
    box-shadow: 4px 4px 0px #000000;
    padding: 0.4rem 0.8rem;
    font-size: 0.85rem;
    font-weight: 900;
    pointer-events: none;
    transform: translate(-50%, -100%);
    animation: toastPopFloat 1.4s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .stamp-ink-particle {
    position: fixed;
    width: 8px;
    height: 8px;
    background: #d92626;
    border-radius: 50%;
    pointer-events: none;
    z-index: 99998;
    box-shadow: 0 0 6px #ef4444;
    animation: particleFly 0.55s ease-out forwards;
  }

  @keyframes toastPopFloat {
    0% { opacity: 0; transform: translate(-50%, 0) scale(0.6) rotate(-8deg); }
    20% { opacity: 1; transform: translate(-50%, -24px) scale(1.15) rotate(4deg); }
    80% { opacity: 1; transform: translate(-50%, -42px) scale(1) rotate(-2deg); }
    100% { opacity: 0; transform: translate(-50%, -60px) scale(0.8) rotate(0deg); }
  }

  @keyframes particleFly {
    0% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    100% { opacity: 0; transform: translate(calc(-50% + var(--tx)), calc(-50% + var(--ty))) scale(0.2); }
  }
</style>
