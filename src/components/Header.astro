---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, '');

const navItems = [
  { name: '首页', href: '/' },
  { name: '机场评测', href: '/category/zhuabao' },
  { name: '机场推荐', href: '/category/mofan' },
  { name: '跑路机场', href: '/category/meishou' },
  { name: '导航页', href: '/nav' },
  { name: '入住教程', href: '/category/jiaocheng' },
  { name: '关于', href: '/about' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <!-- Brand Logo strictly matching user reference image -->
    <a href="/" class="brand-logo" aria-label="VPN查房 首页">
      <span class="brand-stamp">VPN查房</span>
      <span class="brand-tagline font-mono">
        <span class="tagline-triangle">▲</span>
        <span class="tagline-text">每周例行巡检</span>
        <span class="tagline-badge">查</span>
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="主导航">
      <ul>
        {navItems.map((item) => {
          const isActive = item.href === '/' 
            ? currentPath === '' || currentPath === '/' 
            : currentPath.startsWith(item.href);
          return (
            <li>
              <a href={item.href} class={isActive ? 'active' : ''}>
                {item.name}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Mobile Navigation Toggle Button -->
    <button id="mobile-menu-toggle" class="mobile-toggle" aria-label="打开/关闭菜单" aria-expanded="false">
      <span class="menu-icon">☰ 菜单</span>
    </button>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="mobile-menu-drawer hidden">
    <nav aria-label="移动端导航">
      <ul>
        {navItems.map((item) => {
          const isActive = item.href === '/' 
            ? currentPath === '' || currentPath === '/' 
            : currentPath.startsWith(item.href);
          return (
            <li>
              <a href={item.href} class={isActive ? 'active' : ''}>
                {item.name}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<script>
  // Mobile drawer toggle
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menuDrawer = document.getElementById('mobile-menu');

  if (toggleBtn && menuDrawer) {
    toggleBtn.addEventListener('click', () => {
      const expanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!expanded).toString());
      menuDrawer.classList.toggle('hidden');
    });
  }
</script>

<style>
  .site-header {
    background: var(--bg-primary);
    border-bottom: 2px solid var(--border-thick);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(8px);
    background-color: rgba(244, 242, 235, 0.95);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--text-main);
  }

  .brand-stamp {
    background: #000000;
    color: #ffffff;
    font-weight: 900;
    font-size: 1.25rem;
    padding: 0.25rem 0.65rem;
    letter-spacing: 1px;
    border: 2px solid #000000;
    box-shadow: none;
    line-height: 1.2;
    display: inline-flex;
    align-items: center;
  }

  /* Tagline badge strictly matching reference image */
  .brand-tagline {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    font-weight: 800;
    color: #b91c1c;
    background: #fae8e6;
    border: 1.5px solid #b91c1c;
    padding: 0.2rem 0.45rem;
    line-height: 1.2;
  }

  .tagline-triangle {
    color: #b91c1c;
    font-size: 0.65rem;
    line-height: 1;
  }

  .tagline-badge {
    border: 1px solid #b91c1c;
    color: #b91c1c;
    font-size: 0.65rem;
    font-weight: 900;
    padding: 0 0.15rem;
    line-height: 1;
    display: inline-block;
  }

  .desktop-nav ul {
    display: flex;
    list-style: none;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .desktop-nav a {
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.35rem 0.7rem;
    color: #111111;
    transition: all 0.15s ease;
  }

  /* Active item has warm beige background, black border and 2px hard black shadow */
  .desktop-nav a.active {
    background: #eae5d7;
    border: 1.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: #b91c1c;
    font-weight: 800;
  }

  .desktop-nav a:hover:not(.active) {
    color: #b91c1c;
  }

  .mobile-toggle {
    display: none;
    background: var(--bg-surface);
    border: 2px solid var(--border-thick);
    padding: 0.4rem 0.7rem;
    font-weight: 800;
    font-size: 0.9rem;
    cursor: pointer;
    box-shadow: 2px 2px 0px var(--border-thick);
  }

  .mobile-menu-drawer {
    background: var(--bg-surface);
    border-bottom: 2px solid var(--border-thick);
    padding: 1rem 1.25rem;
  }

  .mobile-menu-drawer.hidden {
    display: none;
  }

  .mobile-menu-drawer ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-menu-drawer a {
    display: block;
    padding: 0.6rem 0.8rem;
    font-weight: 700;
    text-decoration: none;
    border: 1.5px solid var(--border-thick);
    background: var(--bg-primary);
  }

  .mobile-menu-drawer a.active {
    background: var(--accent-red);
    color: #ffffff;
  }

  @media (max-width: 768px) {
    .desktop-nav {
      display: none;
    }
    .brand-tagline {
      display: none;
    }
    .mobile-toggle {
      display: block;
    }
  }
</style>
