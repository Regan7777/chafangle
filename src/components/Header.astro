---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, '');

const navItems = [
  { name: '首页', href: '/' },
  { name: '机场评测', href: '/category/zhuabao' },
  { name: '机场推荐', href: '/category/mofan' },
  { name: '跑路机场', href: '/category/meishou' },
  { name: '导航页', href: '/nav' },
  { name: '入住教程', href: '/category/jiaocheng' },
  { name: '关于', href: '/about' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <!-- Brand Logo with Funny Meme Elements -->
    <a href="/" class="brand-logo" aria-label="VPN查房 首页">
      <span class="brand-stamp">VPN查房</span>
      <span id="header-brand-tagline" class="brand-tagline font-mono" title="点击切换宿管梗句！">
        <span class="tagline-siren">🚨</span>
        <span class="tagline-text">每周例行巡检</span>
        <span class="tagline-meme-badge font-mono">查</span>
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="主导航">
      <ul>
        {navItems.map((item) => {
          const isActive = item.href === '/' 
            ? currentPath === '' || currentPath === '/' 
            : currentPath.startsWith(item.href);
          return (
            <li>
              <a href={item.href} class={isActive ? 'active' : ''}>
                {item.name}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Mobile Navigation Toggle Button -->
    <button id="mobile-menu-toggle" class="mobile-toggle" aria-label="打开/关闭菜单" aria-expanded="false">
      <span class="menu-icon">☰ 菜单</span>
    </button>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="mobile-menu-drawer hidden">
    <nav aria-label="移动端导航">
      <ul>
        {navItems.map((item) => {
          const isActive = item.href === '/' 
            ? currentPath === '' || currentPath === '/' 
            : currentPath.startsWith(item.href);
          return (
            <li>
              <a href={item.href} class={isActive ? 'active' : ''}>
                {item.name}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<script>
  // Mobile drawer toggle
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menuDrawer = document.getElementById('mobile-menu');

  if (toggleBtn && menuDrawer) {
    toggleBtn.addEventListener('click', () => {
      const expanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!expanded).toString());
      menuDrawer.classList.toggle('hidden');
    });
  }

  // Funny Dorm Patrol Memes for Logo Tagline
  const funnyTaglines = [
    "🔦 宿管手电强光搜查",
    "🚨 抓包! 谁又在偷偷断流?",
    "🔑 咔哒! 802寝室开门!",
    "⚡ 白天全绿? 晚上突击!",
    "💥 提桶跑路预警系统",
    "🍵 宿管大爷正在看戏",
    "🛡️ 绝无虚标·强效防坑",
    "💮 啪! 盖个五星大印",
    "👻 404号房黑灯瞎火"
  ];

  const taglineEl = document.getElementById('header-brand-tagline');
  const taglineText = taglineEl?.querySelector('.tagline-text');
  let taglineIndex = 0;

  if (taglineEl && taglineText) {
    taglineEl.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      taglineIndex = (taglineIndex + 1) % funnyTaglines.length;
      taglineText.textContent = funnyTaglines[taglineIndex];

      // Shake visual effect on click
      taglineEl.classList.add('tagline-bounce');
      setTimeout(() => taglineEl.classList.remove('tagline-bounce'), 400);
    });
  }
</script>

<style>
  .site-header {
    background: var(--bg-primary);
    border-bottom: 2px solid var(--border-thick);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(8px);
    background-color: rgba(244, 242, 235, 0.95);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--text-main);
  }

  .brand-stamp {
    background: var(--border-thick);
    color: var(--bg-primary);
    font-weight: 900;
    font-size: 1.4rem;
    padding: 0.2rem 0.6rem;
    letter-spacing: 2px;
    border: 2px solid var(--border-thick);
    box-shadow: 2px 2px 0px var(--accent-red);
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .brand-logo:hover .brand-stamp {
    transform: rotate(-3deg) scale(1.05);
  }

  /* Funny Meme Tagline Style */
  .brand-tagline {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--accent-red);
    background: #fee2e2;
    border: 1.5px solid var(--accent-red);
    box-shadow: 2px 2px 0px var(--border-thick);
    padding: 0.15rem 0.5rem;
    cursor: pointer;
    user-select: none;
    position: relative;
    transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .brand-tagline:hover {
    background: var(--accent-red);
    color: #ffffff;
    border-color: var(--border-thick);
    transform: translateY(-2px) rotate(1.5deg);
  }

  .tagline-siren {
    font-size: 0.9rem;
    animation: sirenBlink 1.2s infinite ease-in-out alternate;
  }

  @keyframes sirenBlink {
    0% { transform: scale(1) rotate(0deg); opacity: 1; }
    50% { transform: scale(1.25) rotate(-10deg); opacity: 0.8; }
    100% { transform: scale(1) rotate(10deg); opacity: 1; }
  }

  .tagline-meme-badge {
    background: var(--border-thick);
    color: #ffffff;
    font-size: 0.65rem;
    font-weight: 900;
    padding: 0 0.25rem;
    border-radius: 2px;
    letter-spacing: 0;
  }

  .brand-tagline:hover .tagline-meme-badge {
    background: #ffffff;
    color: var(--accent-red);
  }

  .tagline-bounce {
    animation: taglineBounce 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes taglineBounce {
    0% { transform: scale(0.85) rotate(-6deg); }
    50% { transform: scale(1.15) rotate(4deg); }
    100% { transform: scale(1) rotate(0deg); }
  }

  .desktop-nav ul {
    display: flex;
    list-style: none;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }

  .desktop-nav a {
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.4rem 0.8rem;
    border: 1.5px solid transparent;
    color: var(--text-main);
    transition: all 0.15s ease;
  }

  .desktop-nav a.active {
    background: #ffffff;
    border: 2px solid var(--border-thick);
    color: var(--accent-red);
    font-weight: 800;
  }

  .desktop-nav a:hover:not(.active) {
    background: #e2dfd5;
    border-color: var(--border-thick);
    color: var(--text-main);
  }

  .mobile-toggle {
    display: none;
    background: var(--bg-surface);
    border: 2px solid var(--border-thick);
    padding: 0.4rem 0.7rem;
    font-weight: 800;
    font-size: 0.9rem;
    cursor: pointer;
    box-shadow: 2px 2px 0px var(--border-thick);
  }

  .mobile-menu-drawer {
    background: var(--bg-surface);
    border-bottom: 2px solid var(--border-thick);
    padding: 1rem 1.25rem;
  }

  .mobile-menu-drawer.hidden {
    display: none;
  }

  .mobile-menu-drawer ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-menu-drawer a {
    display: block;
    padding: 0.6rem 0.8rem;
    font-weight: 700;
    text-decoration: none;
    border: 1.5px solid var(--border-thick);
    background: var(--bg-primary);
  }

  .mobile-menu-drawer a.active {
    background: var(--accent-red);
    color: #ffffff;
  }

  @media (max-width: 768px) {
    .desktop-nav {
      display: none;
    }
    .brand-tagline {
      display: none;
    }
    .mobile-toggle {
      display: block;
    }
  }
</style>
