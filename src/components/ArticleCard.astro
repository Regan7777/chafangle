---
import type { VerdictType } from './InspectionBadge.astro';

interface Props {
  title: string;
  description: string;
  slug: string;
  date: string;
  category: string;
  verdict?: VerdictType;
  badge?: string;
  isPinned?: boolean;
}

const { title, description, slug, date, category, verdict, badge, isPinned = false } = Astro.props;

const effectiveVerdict = verdict || (badge?.includes('五星') || badge?.includes('推荐') ? 'five-star' : undefined);

const categoryLabels: Record<string, { name: string; tagClass: string }> = {
  'zhuabao': { name: '机场评测', tagClass: 'badge-zhuabao' },
  'mofan': { name: '机场推荐', tagClass: 'badge-mofan' },
  'meishou': { name: '跑路机场', tagClass: 'badge-meishou' },
  'tongbao': { name: '宿管通报', tagClass: 'badge-tongbao' },
  'jiaocheng': { name: '入住教程', tagClass: 'badge-jiaocheng' },
};

const catInfo = categoryLabels[category] || { name: category, tagClass: 'badge-default' };
---

<article class={`article-card industrial-box ${isPinned ? 'is-pinned-card' : ''}`}>
  <div class="card-meta-bar">
    <div class="meta-left">
      {isPinned && <span class="pinned-tag">📌 宿管置顶</span>}
      <span class={`category-tag ${catInfo.tagClass}`}>{catInfo.name}</span>
      <time datetime={date} class="post-date font-mono">{date}</time>
    </div>
    {effectiveVerdict === 'five-star' && <span class="verdict-mini gold">🏆 五星推荐</span>}
    {effectiveVerdict === 'warning' && <span class="verdict-mini amber">⚠️ 谨慎观察</span>}
    {effectiveVerdict === 'confiscated' && <span class="verdict-mini red">🚨 直接拉闸</span>}
    {effectiveVerdict === 'ghost' && <span class="verdict-mini gray">👻 已提桶</span>}
  </div>

  <h3 class="post-title">
    <a href={`/posts/${slug}`}>
      {title}
    </a>
  </h3>

  <p class="post-excerpt">
    {description}
  </p>

  <div class="card-footer-action">
    <a href={`/posts/${slug}`} class="read-more-link">
      阅读巡楼纪要全文 ➔
    </a>
  </div>
</article>

<style>
  .article-card {
    margin-bottom: 1.5rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    background: #ffffff;
  }

  .article-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0px var(--border-thick);
  }

  .is-pinned-card {
    border-left: 6px solid var(--accent-red);
    background: #ffffff;
  }

  .card-meta-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.8rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .meta-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .pinned-tag {
    background: var(--accent-red);
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.15rem 0.5rem;
    line-height: 1.2;
  }

  .category-tag {
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--border-thick);
    font-family: var(--font-mono);
    line-height: 1.2;
  }

  .badge-zhuabao { background: #e0f2fe; color: #0369a1; }
  .badge-mofan { background: #dcfce7; color: #15803d; }
  .badge-meishou { background: #fee2e2; color: #b91c1c; }
  .badge-tongbao { background: #fef3c7; color: #b45309; }
  .badge-jiaocheng { background: #f3e8ff; color: #7e22ce; }

  .post-date {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .verdict-mini {
    font-size: 0.82rem;
    font-weight: 800;
    font-family: var(--font-mono);
    padding: 0.2rem 0.55rem;
    border: 1.5px solid var(--border-thick);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    line-height: 1.2;
    white-space: nowrap;
  }

  .verdict-mini.gold { background: #fef08a; color: #854d0e; }
  .verdict-mini.amber { background: #fde68a; color: #92400e; }
  .verdict-mini.red { background: #fee2e2; color: #991b1b; border-color: #dc2626; }
  .verdict-mini.gray { background: #e5e7eb; color: #374151; }

  .post-title {
    font-size: 1.35rem;
    margin: 0.4rem 0 0.6rem 0;
  }

  .post-title a {
    text-decoration: none;
    color: var(--text-main);
  }

  .post-title a:hover {
    color: var(--accent-red);
  }

  .post-excerpt {
    font-size: 0.95rem;
    color: #333333;
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .card-footer-action {
    border-top: 1px dashed var(--border-muted);
    padding-top: 0.6rem;
    display: flex;
    justify-content: flex-end;
  }

  .read-more-link {
    font-size: 0.85rem;
    font-weight: 800;
    font-family: var(--font-mono);
    color: var(--accent-red);
    text-decoration: none;
  }

  .read-more-link:hover {
    text-decoration: underline;
  }
</style>
