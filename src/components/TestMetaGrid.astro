---
interface ItemMetric {
  name: string;
  result: string;
  status?: 'good' | 'warn' | 'bad';
}

interface Props {
  testDate?: string;
  location?: string;
  isp?: string;
  peakHours?: string;
  metrics?: ItemMetric[];
}

const {
  testDate = '2026年第40周 (2026-10-01 ~ 10-07)',
  location = '华东二线城市',
  isp = '电信 1000M / 移动 500M 双线周巡实测',
  peakHours = '周巡查周期: 7×24h 随机抽样',
  metrics = [
    { name: 'TCP 周平均连通率', result: '99.8% (稳定)', status: 'good' },
    { name: '周巡查平均延迟', result: '142 ms', status: 'good' },
    { name: '周巡查平均丢包率', result: '0.4%', status: 'good' },
    { name: '4K 视频开播加载速度', result: '0.8 秒', status: 'good' },
  ]
} = Astro.props;
---

<div class="test-meta-container">
  <div class="meta-header-bar">
    <span class="meta-title">📋 宿管周巡查测试数据记录表</span>
    <span class="meta-stamp-badge">周巡实测存照</span>
  </div>

  <div class="meta-grid">
    <div class="grid-cell">
      <span class="cell-label">周巡查周期与时间</span>
      <span class="cell-val font-mono">{testDate}</span>
    </div>
    <div class="grid-cell">
      <span class="cell-label">测试地点环境</span>
      <span class="cell-val">{location} ({isp})</span>
    </div>
    <div class="grid-cell">
      <span class="cell-label">例行巡检模式</span>
      <span class="cell-val font-mono highlight-red">{peakHours}</span>
    </div>
  </div>

  <div class="metrics-table-wrapper">
    <table class="metrics-table">
      <thead>
        <tr>
          <th>周巡查观察项目</th>
          <th>全周实测表现</th>
          <th>宿管评级</th>
        </tr>
      </thead>
      <tbody>
        {metrics.map((item) => (
          <tr>
            <td class="metric-name">{item.name}</td>
            <td class="metric-res font-mono">{item.result}</td>
            <td>
              {item.status === 'good' && <span class="status-tag status-good">良好</span>}
              {item.status === 'warn' && <span class="status-tag status-warn">波动</span>}
              {item.status === 'bad' && <span class="status-tag status-bad">拉闸</span>}
              {!item.status && <span class="status-tag status-normal">正常</span>}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="test-reminder">
    ⚠️ <strong>注意：</strong>测试结果仅代表当时周巡查环境与抽样时段，不构成购买建议。
  </p>
</div>

<style>
  .test-meta-container {
    background: #ffffff;
    border: 2.5px solid var(--border-thick);
    box-shadow: 4px 4px 0px var(--border-thick);
    padding: 1.25rem;
    margin: 1.5rem 0;
  }

  .meta-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid var(--border-thick);
    padding-bottom: 0.6rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .meta-title {
    font-weight: 900;
    font-size: 1.1rem;
  }

  .meta-stamp-badge {
    background: var(--bg-primary);
    border: 1.5px solid var(--border-thick);
    padding: 0.15rem 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    font-family: var(--font-mono);
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-bottom: 1.25rem;
    background: #f8f7f2;
    padding: 0.8rem;
    border: 1px solid var(--border-muted);
  }

  .grid-cell {
    display: flex;
    flex-direction: column;
  }

  .cell-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 700;
  }

  .cell-val {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-main);
  }

  .font-mono {
    font-family: var(--font-mono);
  }

  .highlight-red {
    color: var(--accent-red);
  }

  .metrics-table-wrapper {
    overflow-x: auto;
  }

  .metrics-table {
    margin: 0.5rem 0 1rem 0;
  }

  .metric-name {
    font-weight: 700;
  }

  .metric-res {
    font-weight: 700;
  }

  .status-tag {
    display: inline-block;
    padding: 0.1rem 0.4rem;
    font-size: 0.8rem;
    font-weight: 800;
    font-family: var(--font-mono);
    border: 1px solid var(--border-thick);
  }

  .status-good { background: #dcfce7; color: #166534; }
  .status-warn { background: #fef3c7; color: #92400e; }
  .status-bad { background: #fee2e2; color: #991b1b; }
  .status-normal { background: #f3f4f6; color: #374151; }

  .test-reminder {
    font-size: 0.85rem;
    color: #666666;
    margin-bottom: 0;
    padding-top: 0.5rem;
    border-top: 1.5px dashed var(--border-muted);
  }
</style>
