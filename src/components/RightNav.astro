---
interface NavItem {
  id: string;
  name: string;
  tag: string;
  href: string;
  tagType?: 'red' | 'dark' | 'green' | 'orange' | 'outline';
  isActive?: boolean;
}

interface Props {
  title?: string;
  activeId?: string;
  items?: NavItem[];
}

const defaultItems: NavItem[] = [
  { id: '01', name: '神行加速', tag: '7折', tagType: 'red', href: '/posts/14-shenxing-jiasu-iepl-premium-review' },
  { id: '02', name: '大佬云', tag: '7折', tagType: 'red', href: '/posts/15-dalaoyun-bgp-high-value-review' },
  { id: '03', name: '闪电鼠', tag: '低迟', tagType: 'orange', href: '/posts/16-shandianshu-fast-latency-review' },
  { id: '04', name: '榴莲云', tag: '解锁', tagType: 'green', href: '/posts/17-liulianyun-native-ip-unlock-review' },
  { id: '05', name: '环球梯', tag: '商务', tagType: 'dark', href: '/posts/18-huanqiuti-global-business-review' },
  { id: '06', name: '云界线', tag: '首单7折', tagType: 'red', href: '/posts/19-yunjiexian-pure-iepl-dedicated-review' },
  { id: '07', name: '快连 VPN', tag: '免检', tagType: 'dark', href: '/posts/05-custom-bgp-iepl-hybrid-airport-review' },
  { id: '08', name: '当场抓包', tag: '观察', tagType: 'outline', href: '/category/zhuabao' },
];

const { title = "⚡ 快捷导航卷宗", activeId = "01", items = defaultItems } = Astro.props;
---

<aside class="right-nav-card industrial-box">
  <div class="right-nav-header">
    <h3 class="right-nav-title font-mono">{title}</h3>
    <span class="right-nav-status font-mono">LIVE</span>
  </div>

  <nav class="right-nav-list" aria-label="右侧快捷导航">
    {items.map((item) => {
      const isSelected = item.isActive || item.id === activeId;
      return (
        <a
          href={item.href}
          class={`right-nav-item ${isSelected ? 'is-active' : ''}`}
          aria-current={isSelected ? 'page' : undefined}
        >
          <div class="right-nav-left">
            <span class="nav-num font-mono">{item.id}.</span>
            <span class="nav-name">{item.name}</span>
          </div>

          <div class="right-nav-right">
            {isSelected && <span class="active-dot font-mono" title="默认高亮选中">★</span>}
            <span class={`nav-badge tag-${item.tagType || 'red'} ${isSelected ? 'tag-active' : ''}`}>
              {item.tag}
            </span>
          </div>
        </a>
      );
    })}
  </nav>
</aside>

<style>
  .right-nav-card {
    background: #ffffff;
    border: 2px solid #111111;
    box-shadow: 4px 4px 0px #111111;
    padding: 1.25rem;
    margin-bottom: 2rem;
  }

  .right-nav-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid #111111;
    padding-bottom: 0.6rem;
    margin-bottom: 1rem;
  }

  .right-nav-title {
    font-size: 1.1rem;
    font-weight: 900;
    margin: 0;
    color: #111111;
    letter-spacing: -0.02em;
  }

  .right-nav-status {
    font-size: 0.75rem;
    font-weight: 800;
    background: #d92626;
    color: #ffffff;
    padding: 0.15rem 0.45rem;
    border: 1px solid #111111;
    letter-spacing: 0.05em;
  }

  .right-nav-list {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  /* Item Layout: '序号. 名称 + 右侧标签' 左右对齐 */
  .right-nav-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.55rem 0.75rem;
    background: #f9f8f3;
    border: 1.5px solid #dcdad0;
    color: #222222;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    transition: all 0.15s ease-in-out;
  }

  .right-nav-item:hover {
    background: #111111;
    color: #ffffff;
    border-color: #111111;
    transform: translateX(-2px);
    box-shadow: 2px 2px 0px #d92626;
  }

  .right-nav-left {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .nav-num {
    color: #777777;
    font-weight: 700;
    font-size: 0.88rem;
  }

  .right-nav-item:hover .nav-num {
    color: #e5e3da;
  }

  .nav-name {
    font-weight: 700;
  }

  .right-nav-right {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .active-dot {
    color: #d92626;
    font-size: 0.9rem;
    font-weight: 900;
    animation: pulse 1.5s infinite alternate;
  }

  @keyframes pulse {
    0% { transform: scale(1); opacity: 0.8; }
    100% { transform: scale(1.2); opacity: 1; }
  }

  /* Auxiliary Badges */
  .nav-badge {
    display: inline-block;
    padding: 0.1rem 0.45rem;
    font-size: 0.75rem;
    font-weight: 800;
    border: 1px solid #111111;
    font-family: var(--font-mono, monospace);
    white-space: nowrap;
    border-radius: 0px;
  }

  .tag-red {
    background: #fee2e2;
    color: #dc2626;
    border-color: #dc2626;
  }

  .tag-orange {
    background: #ffedd5;
    color: #ea580c;
    border-color: #ea580c;
  }

  .tag-green {
    background: #dcfce7;
    color: #16a34a;
    border-color: #16a34a;
  }

  .tag-dark {
    background: #18181b;
    color: #ffffff;
    border-color: #18181b;
  }

  .tag-outline {
    background: #ffffff;
    color: #4b5563;
    border-color: #9ca3af;
  }

  /* 默认高亮 / 选中状态 Style */
  .right-nav-item.is-active {
    background: #111111;
    color: #ffffff;
    border: 2px solid #d92626;
    box-shadow: 3px 3px 0px #d92626;
    position: relative;
  }

  .right-nav-item.is-active .nav-num {
    color: #f87171;
  }

  .right-nav-item.is-active .nav-badge {
    background: #d92626;
    color: #ffffff;
    border-color: #ffffff;
  }
</style>
