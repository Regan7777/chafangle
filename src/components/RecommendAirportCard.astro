---
export interface RecommendAirportData {
  rank: string;
  rankTitle: string;
  name: string;
  tag: string;
  badgeType: 'red' | 'dark' | 'green' | 'orange';
  rating: string;
  pricePlan: string;
  promoCode: string;
  annualPlan?: string;
  onDemandPlan?: string;
  architecture: string;
  protocols: string[];
  summary: string;
  features: string[];
  metrics: { name: string; value: string }[];
  reviewUrl: string;
  officialUrl: string;
}

interface Props {
  airport: RecommendAirportData;
}

const { airport } = Astro.props;
---

<div class={`recommend-airport-card industrial-box ${airport.rank === '01' ? 'is-top-pick' : ''}`}>
  <!-- Card Header -->
  <div class="card-header-bar">
    <div class="header-left">
      <span class="rank-badge font-mono">#{airport.rank}</span>
      <div class="name-group">
        <h3 class="airport-title">{airport.name}</h3>
        <span class="rank-title font-mono">{airport.rankTitle}</span>
      </div>
    </div>
    <div class="header-right">
      <span class="pill-badge pill-green font-mono">📱 不限设备</span>
      <span class={`pill-badge pill-${airport.badgeType} font-mono`}>
        {airport.tag}
      </span>
    </div>
  </div>

  <!-- Price & Promo Code Strip -->
  <div class="promo-strip industrial-box-dark">
    <div class="price-info">
      <span class="price-label font-mono">核准特惠:</span>
      <span class="price-value font-mono">{airport.pricePlan}</span>
      {airport.annualPlan && (
        <span class="extra-plan font-mono">· {airport.annualPlan}</span>
      )}
      {airport.onDemandPlan && (
        <span class="extra-plan font-mono">· {airport.onDemandPlan}</span>
      )}
    </div>
    <div class="promo-code-box font-mono" title="点击优惠码复制">
      <span class="code-label">7折优惠码:</span>
      <code class="code-text font-mono">{airport.promoCode}</code>
      <button 
        type="button" 
        class="copy-code-btn font-mono" 
        data-code={airport.promoCode}
        aria-label={`复制优惠码 ${airport.promoCode}`}
      >
        📋 复制
      </button>
    </div>
  </div>

  <!-- Tech Specs & Protocols -->
  <div class="tech-row font-mono">
    <span class="tech-label">线路架构:</span>
    <span class="tech-arch">{airport.architecture}</span>
    <div class="protocol-tags">
      {airport.protocols.map((proto) => (
        <span class="proto-tag font-mono">{proto}</span>
      ))}
    </div>
  </div>

  <!-- Airport Introduction (核心简介) -->
  <div class="summary-box">
    <h4 class="summary-heading font-mono">【宿管查房档案简介】</h4>
    <p class="summary-content">
      {airport.summary}
    </p>
  </div>

  <!-- Core Highlights -->
  <div class="features-list">
    {airport.features.map((feat) => (
      <div class="feature-item">
        <span class="check-icon">✓</span>
        <span class="feature-text">{feat}</span>
      </div>
    ))}
  </div>

  <!-- Metrics Grid -->
  <div class="metrics-grid font-mono">
    {airport.metrics.map((m) => (
      <div class="metric-cell">
        <span class="metric-name">{m.name}</span>
        <span class="metric-val">{m.value}</span>
      </div>
    ))}
  </div>

  <!-- CTA Buttons -->
  <div class="card-action-bar">
    <a href={airport.reviewUrl} class="btn-review font-mono">
      📖 查阅深度实测卷宗
    </a>
    <a 
      href={airport.officialUrl} 
      target="_blank" 
      rel="noopener sponsored" 
      class="btn-official font-mono"
    >
      🚀 直达官网（享新客7折）➔
    </a>
  </div>
</div>

<style>
  .recommend-airport-card {
    background: #ffffff;
    padding: 1.5rem;
    margin-bottom: 2rem;
    border-width: 3px;
    border-color: #1a1a1a;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .recommend-airport-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0px #1a1a1a;
  }

  .is-top-pick {
    border-color: var(--accent-red, #dc2626);
    border-width: 3.5px;
    box-shadow: 4px 4px 0px rgba(220, 38, 38, 0.4);
    position: relative;
  }

  .is-top-pick::before {
    content: "★ 宿管全站首推主力 ★";
    position: absolute;
    top: -12px;
    left: 20px;
    background: var(--accent-red, #dc2626);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 2px 10px;
    letter-spacing: 1px;
    border: 1.5px solid #1a1a1a;
    font-family: var(--font-mono, monospace);
  }

  /* Header Bar */
  .card-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.2rem;
    padding-bottom: 0.8rem;
    border-bottom: 2px solid #eaeaea;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .rank-badge {
    background: #1a1a1a;
    color: #ffffff;
    font-size: 1.25rem;
    font-weight: 900;
    padding: 0.35rem 0.7rem;
    border-radius: 4px;
    line-height: 1;
    border: 1px solid #000;
  }

  .is-top-pick .rank-badge {
    background: var(--accent-red, #dc2626);
    box-shadow: 2px 2px 0px #1a1a1a;
  }

  .name-group {
    display: flex;
    flex-direction: column;
  }

  .airport-title {
    font-size: 1.5rem;
    font-weight: 900;
    margin: 0;
    color: #111111;
    letter-spacing: -0.5px;
  }

  .rank-title {
    font-size: 0.78rem;
    color: #666;
    margin-top: 0.15rem;
    font-weight: 600;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .pill-badge {
    font-size: 0.78rem;
    font-weight: 800;
    padding: 0.3rem 0.65rem;
    border: 1.5px solid #1a1a1a;
    box-shadow: 2px 2px 0px #1a1a1a;
  }

  .pill-red {
    background: #fee2e2;
    color: #991b1b;
  }

  .pill-dark {
    background: #f3f4f6;
    color: #1f2937;
  }

  .pill-green {
    background: #dcfce7;
    color: #166534;
  }

  .pill-orange {
    background: #ffedd5;
    color: #9a3412;
  }

  .rating-badge {
    background: #fef08a;
    color: #854d0e;
    font-size: 0.82rem;
    font-weight: 800;
    padding: 0.3rem 0.6rem;
    border: 1.5px solid #1a1a1a;
    box-shadow: 2px 2px 0px #1a1a1a;
  }

  /* Promo Strip */
  .promo-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.8rem;
    padding: 0.85rem 1rem;
    margin-bottom: 1.1rem;
    border: 2px solid #1a1a1a;
    background: #18181b;
    color: #f4f4f5;
  }

  .price-info {
    font-size: 0.88rem;
    line-height: 1.4;
  }

  .price-label {
    color: #a1a1aa;
    margin-right: 0.4rem;
  }

  .price-value {
    color: #facc15;
    font-weight: 800;
    font-size: 0.98rem;
  }

  .extra-plan {
    color: #d4d4d8;
    margin-left: 0.4rem;
    font-size: 0.82rem;
  }

  .promo-code-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #27272a;
    padding: 0.35rem 0.65rem;
    border: 1.5px dashed #71717a;
    border-radius: 3px;
  }

  .code-label {
    color: #a1a1aa;
    font-size: 0.78rem;
  }

  .code-text {
    color: #ef4444;
    font-weight: 900;
    font-size: 0.95rem;
    background: #3f3f46;
    padding: 0.15rem 0.4rem;
    border-radius: 2px;
    letter-spacing: 0.5px;
  }

  .copy-code-btn {
    background: #ef4444;
    color: #ffffff;
    border: 1px solid #b91c1c;
    padding: 0.15rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    border-radius: 2px;
    transition: background 0.15s ease;
  }

  .copy-code-btn:hover {
    background: #dc2626;
  }

  .copy-code-btn.copied {
    background: #22c55e;
    border-color: #16a34a;
  }

  /* Tech specs */
  .tech-row {
    font-size: 0.82rem;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    color: #4b5563;
  }

  .tech-label {
    font-weight: 800;
    color: #1f2937;
  }

  .tech-arch {
    color: #374151;
    font-weight: 600;
  }

  .protocol-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .proto-tag {
    background: #f3f4f6;
    color: #111827;
    border: 1px solid #d1d5db;
    padding: 0.15rem 0.45rem;
    font-size: 0.72rem;
    font-weight: 700;
    border-radius: 3px;
  }

  /* Summary Box */
  .summary-box {
    background: #f8fafc;
    border-left: 4px solid var(--accent-red, #dc2626);
    padding: 0.9rem 1.1rem;
    margin-bottom: 1.1rem;
    border-top: 1px solid #e2e8f0;
    border-right: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
  }

  .summary-heading {
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--accent-red, #dc2626);
    margin: 0 0 0.4rem 0;
  }

  .summary-content {
    font-size: 0.92rem;
    line-height: 1.65;
    color: #334155;
    margin: 0;
  }

  /* Features List */
  .features-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.45rem;
    margin-bottom: 1.1rem;
  }

  @media (min-width: 768px) {
    .features-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-size: 0.85rem;
    color: #1e293b;
    line-height: 1.4;
  }

  .check-icon {
    color: #16a34a;
    font-weight: 900;
    font-size: 0.9rem;
    line-height: 1.2;
  }

  .feature-text {
    color: #334155;
  }

  /* Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
    background: #f1f5f9;
    padding: 0.75rem;
    border: 1px solid #cbd5e1;
    margin-bottom: 1.2rem;
  }

  @media (min-width: 640px) {
    .metrics-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .metric-cell {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    padding: 0.5rem 0.6rem;
    border: 1px solid #e2e8f0;
  }

  .metric-name {
    font-size: 0.72rem;
    color: #64748b;
    margin-bottom: 0.2rem;
  }

  .metric-val {
    font-size: 0.88rem;
    font-weight: 800;
    color: #0f172a;
  }

  /* CTA Buttons */
  .card-action-bar {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .btn-review,
  .btn-official {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1.2rem;
    font-size: 0.88rem;
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    border: 2px solid #1a1a1a;
  }

  .btn-review {
    background: #ffffff;
    color: #1a1a1a;
    box-shadow: 2px 2px 0px #1a1a1a;
  }

  .btn-review:hover {
    background: #f3f4f6;
    transform: translate(-1.5px, -1.5px);
    box-shadow: 4px 4px 0px #1a1a1a;
  }

  .btn-official {
    background: var(--accent-red, #dc2626);
    color: #ffffff;
    box-shadow: 3px 3px 0px #1a1a1a;
    flex: 1;
    min-width: 200px;
  }

  .btn-official:hover {
    background: #b91c1c;
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px #1a1a1a;
    color: #ffffff;
  }
</style>

<script>
  // Interactive copy button
  document.querySelectorAll('.copy-code-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const code = btn.getAttribute('data-code');
      if (!code) return;
      try {
        await navigator.clipboard.writeText(code);
        const originalText = btn.textContent;
        btn.textContent = '✓ 已复制!';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = originalText;
          btn.classList.remove('copied');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy code:', err);
      }
    });
  });
</script>
